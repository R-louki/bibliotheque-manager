{"n":86,"name":"الطارق","ayat":[{"n":1,"t":"وَالسَّمَآءِ وَالطَّارِقِ","p":"591","h":[1]},{"n":2,"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لطَّارِقُ","p":"591","h":[2]},{"n":3,"t":"اُ۬لنَّجْمُ اُ۬لثَّاقِبُ","p":"591","h":[3]},{"n":4,"t":"إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ","p":"591","h":[4]},{"n":5,"t":"فَلْيَنظُرِ اِ۬لْإِنسَٰنُ مِمَّ خُلِقَۖ","p":"591","h":[5]},{"n":6,"t":"خُلِقَ مِن مَّآءٖ دَافِقٖ","p":"591","h":[6]},{"n":7,"t":"يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ","p":"591","h":[7]},{"n":8,"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ","p":"591","h":[8]},{"n":9,"t":"يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ","p":"591","h":[9]},{"n":10,"t":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ","p":"591","h":[10]},{"n":11,"t":"وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ","p":"591","h":[11]},{"n":12,"t":"وَالْأَرْضِ ذَاتِ اِ۬لصَّدْعِ","p":"591","h":[12]},{"n":13,"t":"إِنَّهُۥ لَقَوْلٞ فَصْلٞ","p":"591","h":[13]},{"n":14,"t":"وَمَا هُوَ بِالْهَزْلِۖ","p":"591","h":[14]},{"n":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْداٗ","p":"591","h":[15]},{"n":16,"t":"وَأَكِيدُ كَيْداٗۖ","p":"591","h":[16]},{"n":17,"t":"فَمَهِّلِ اِ۬لْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْداَۢۖ","p":"591","h":[17]}]}