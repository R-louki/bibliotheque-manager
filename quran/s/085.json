{"n":85,"name":"البروج","ayat":[{"n":1,"t":"وَالسَّمَآءِ ذَاتِ اِ۬لْبُرُوجِ","p":"590","h":[1]},{"n":2,"t":"وَالْيَوْمِ اِ۬لْمَوْعُودِ","p":"590","h":[2]},{"n":3,"t":"وَشَاهِدٖ وَمَشْهُودٖ","p":"590","h":[3]},{"n":4,"t":"قُتِلَ أَصْحَٰبُ اُ۬لْأُخْدُودِ","p":"590","h":[4]},{"n":5,"t":"اِ۬لنَّارِ ذَاتِ اِ۬لْوَقُودِ","p":"590","h":[5]},{"n":6,"t":"إِذْ هُمْ عَلَيْهَا قُعُودٞ","p":"590","h":[6]},{"n":7,"t":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٞۖ","p":"590","h":[7]},{"n":8,"t":"وَمَا نَقَمُواْ مِنْهُمْ إِلَّا أَنْ يُّؤْمِنُواْ بِاللَّهِ اِ۬لْعَزِيزِ اِ۬لْحَمِيدِ","p":"590","h":[8]},{"n":9,"t":"اِ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِۖ وَاللَّهُ عَلَىٰ كُلِّ شَےْءٖ شَهِيدٌۖ","p":"590","h":[9]},{"n":10,"t":"إِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُؤْمِنِينَ وَالْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ","p":"590","h":[10]},{"n":11,"t":"إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٞ تَجْرِے مِن تَحْتِهَا اَ۬لْأَنْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ","p":"590","h":[11]},{"n":12,"t":"۞ إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌۖ","p":"590","h":[12]},{"n":13,"t":"إِنَّهُۥ هُوَ يُبْدِۓُ وَيُعِيدُۖ","p":"590","h":[13]},{"n":14,"t":"وَهْوَ اَ۬لْغَفُورُ اُ۬لْوَدُودُ","p":"590","h":[14]},{"n":15,"t":"ذُو اُ۬لْعَرْشِۖ اِ۬لْمَجِيدُ","p":"590","h":[15]},{"n":16,"t":"فَعَّالٞ لِّمَا يُرِيدُۖ","p":"590","h":[16]},{"n":17,"t":"هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْجُنُودِ","p":"590","h":[17]},{"n":18,"t":"فِرْعَوْنَ وَثَمُودَۖ","p":"590","h":[18]},{"n":19,"t":"بَلِ اِ۬لذِينَ كَفَرُواْ فِے تَكْذِيبٖ","p":"590","h":[19]},{"n":20,"t":"وَاللَّهُ مِنْ وَّرَآئِهِم مُّحِيطُۢۖ","p":"590","h":[20]},{"n":21,"t":"بَلْ هُوَ قُرْءَانٞ مَّجِيدٞ","p":"590","h":[21]},{"n":22,"t":"فِے لَوْحٖ مَّحْفُوظُۢۖ","p":"590","h":[22]}]}