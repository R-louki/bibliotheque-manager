{"n":81,"name":"التكوير","ayat":[{"n":1,"t":"إِذَا اَ۬لشَّمْسُ كُوِّرَتْ","p":"586","h":[1]},{"n":2,"t":"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ","p":"586","h":[2]},{"n":3,"t":"وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ","p":"586","h":[3]},{"n":4,"t":"وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ","p":"586","h":[4]},{"n":5,"t":"وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ","p":"586","h":[5]},{"n":6,"t":"وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ","p":"586","h":[6]},{"n":7,"t":"وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ","p":"586","h":[7]},{"n":8,"t":"وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ","p":"586","h":[8]},{"n":9,"t":"بِأَيِّ ذَنۢبٖ قُتِلَتْ","p":"586","h":[9]},{"n":10,"t":"وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ","p":"586","h":[10]},{"n":11,"t":"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ","p":"586","h":[11]},{"n":12,"t":"وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ","p":"586","h":[12]},{"n":13,"t":"وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ","p":"586","h":[13]},{"n":14,"t":"عَلِمَتْ نَفْسٞ مَّا أَحْضَرَتْۖ","p":"586","h":[14]},{"n":15,"t":"فَلَا أُقْسِمُ بِالْخُنَّسِ","p":"586","h":[15]},{"n":16,"t":"اِ۬لْجَوَارِ اِ۬لْكُنَّسِ","p":"586","h":[16]},{"n":17,"t":"وَاليْلِ إِذَا عَسْعَسَ","p":"586","h":[17]},{"n":18,"t":"وَالصُّبْحِ إِذَا تَنَفَّسَ","p":"586","h":[18]},{"n":19,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ","p":"586","h":[19]},{"n":20,"t":"ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ","p":"586","h":[20]},{"n":21,"t":"مُّطَاعٖ ثَمَّ أَمِينٖۖ","p":"586","h":[21]},{"n":22,"t":"وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ","p":"586","h":[22]},{"n":23,"t":"وَلَقَدْ رَءَاهُ بِالْأُفُقِ اِ۬لْمُبِينِۖ","p":"586","h":[23]},{"n":24,"t":"وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ","p":"586","h":[24]},{"n":25,"t":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ","p":"586","h":[25]},{"n":26,"t":"فَأَيْنَ تَذْهَبُونَۖ","p":"586","h":[26]},{"n":27,"t":"إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ","p":"586","h":[27]},{"n":28,"t":"لِمَن شَآءَ مِنكُمْ أَنْ يَّسْتَقِيمَۖ","p":"586","h":[28]},{"n":29,"t":"وَمَا تَشَآءُونَ إِلَّا أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ","p":"586","h":[29]}]}