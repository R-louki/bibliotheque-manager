{"n":55,"name":"الرحمن","ayat":[{"n":1,"t":"اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ","p":"531","h":[1,2]},{"n":2,"t":"خَلَقَ اَ۬لْإِنسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ","p":"531","h":[3,4]},{"n":3,"t":"اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ","p":"531","h":[5]},{"n":4,"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ","p":"531","h":[6]},{"n":5,"t":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ","p":"531","h":[7]},{"n":6,"t":"أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ","p":"531","h":[8]},{"n":7,"t":"وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ","p":"531","h":[9]},{"n":8,"t":"وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ","p":"531","h":[10]},{"n":9,"t":"فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لْأَكْمَامِ","p":"531","h":[11]},{"n":10,"t":"وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ","p":"531","h":[12]},{"n":11,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"531","h":[13]},{"n":12,"t":"خَلَقَ اَ۬لْإِنسَٰنَ مِن صَلْصَٰلٖ كَالْفَخَّارِ","p":"531","h":[14]},{"n":13,"t":"وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نَّارٖۖ","p":"531","h":[15]},{"n":14,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"531","h":[16]},{"n":15,"t":"رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ","p":"531","h":[17]},{"n":16,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"531","h":[18]},{"n":17,"t":"مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ","p":"532","h":[19]},{"n":18,"t":"بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ","p":"532","h":[20]},{"n":19,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[21]},{"n":20,"t":"يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ","p":"532","h":[22]},{"n":21,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[23]},{"n":22,"t":"وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالْأَعْلَٰمِۖ","p":"532","h":[24]},{"n":23,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[25]},{"n":24,"t":"كُلُّ مَنْ عَلَيْهَا فَانٖ","p":"532","h":[26]},{"n":25,"t":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالْإِكْرَامِ","p":"532","h":[27]},{"n":26,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[28]},{"n":27,"t":"يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالْأَرْضِۖ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ","p":"532","h":[29]},{"n":28,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[30]},{"n":29,"t":"سَنَفْرُغُ لَكُمْ أَيُّهَ اَ۬لثَّقَلَٰنِۖ","p":"532","h":[31]},{"n":30,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[32]},{"n":31,"t":"يَٰمَعْشَرَ اَ۬لْجِنِّ وَالْإِنسِ إِنِ اِ۪سْتَطَعْتُمْ أَن تَنفُذُواْ مِنْ أَقْطَارِ اِ۬لسَّمَٰوَٰتِ وَالْأَرْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ","p":"532","h":[33]},{"n":32,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[34]},{"n":33,"t":"يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نَّارٖ","p":"532","h":[35]},{"n":34,"t":"وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ","p":"532","h":[35]},{"n":35,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[36]},{"n":36,"t":"فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ","p":"532","h":[37]},{"n":37,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","p":"532","h":[38]},{"n":38,"t":"فَيَوْمَئِذٖ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦ إِنسٞ وَلَا جَآنّٞۖ","p":"532","h":[39]},{"n":39,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"532","h":[40]},{"n":40,"t":"۞ يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِالنَّوَٰصِے وَالْأَقْدَامِۖ","p":"532","h":[41]},{"n":41,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[42]},{"n":42,"t":"هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ","p":"533","h":[43]},{"n":43,"t":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٖۖ","p":"533","h":[44]},{"n":44,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[45]},{"n":45,"t":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ","p":"533","h":[46]},{"n":46,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","p":"533","h":[47]},{"n":47,"t":"ذَوَاتَا أَفْنَانٖۖ","p":"533","h":[48]},{"n":48,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[49]},{"n":49,"t":"فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِۖ","p":"533","h":[50]},{"n":50,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[51]},{"n":51,"t":"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوْجَٰنِۖ","p":"533","h":[52]},{"n":52,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[53]},{"n":53,"t":"مُتَّكِـِٕينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٖ وَجَنَا اَ۬لْجَنَّتَيْنِ دَانٖۖ","p":"533","h":[54]},{"n":54,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[55]},{"n":55,"t":"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ","p":"533","h":[56]},{"n":56,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[57]},{"n":57,"t":"كَأَنَّهُنَّ اَ۬لْيَاقُوتُ وَالْمَرْجَانُۖ","p":"533","h":[58]},{"n":58,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[59]},{"n":59,"t":"هَلْ جَزَآءُ اُ۬لْإِحْسَٰنِ إِلَّا اَ۬لْإِحْسَٰنُۖ","p":"533","h":[60]},{"n":60,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[61]},{"n":61,"t":"وَمِن دُونِهِمَا جَنَّتَٰنِ","p":"533","h":[62]},{"n":62,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","p":"533","h":[63]},{"n":63,"t":"مُدْهَآمَّتَٰنِۖ","p":"533","h":[64]},{"n":64,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[65]},{"n":65,"t":"فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِۖ","p":"533","h":[66]},{"n":66,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[67]},{"n":67,"t":"فِيهِمَا فَٰكِهَةٞ وَنَخْلٞ وَرُمَّانٞۖ","p":"533","h":[68]},{"n":68,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"533","h":[69]},{"n":69,"t":"فِيهِنَّ خَيْرَٰتٌ حِسَانٞۖ","p":"534","h":[70]},{"n":70,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"534","h":[71]},{"n":71,"t":"حُورٞ مَّقْصُورَٰتٞ فِے اِ۬لْخِيَامِۖ","p":"534","h":[72]},{"n":72,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"534","h":[73]},{"n":73,"t":"لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ","p":"534","h":[74]},{"n":74,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"534","h":[75]},{"n":75,"t":"مُتَّكِـِٕينَ عَلَىٰ رَفْرَفٍ خُضْرٖ وَعَبْقَرِيٍّ حِسَانٖۖ","p":"534","h":[76]},{"n":76,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","p":"534","h":[77]},{"n":77,"t":"تَبَٰرَكَ اَ۪سْمُ رَبِّكَ ذِے اِ۬لْجَلَٰلِ وَالْإِكْرَامِۖ","p":"534","h":[78]}]}