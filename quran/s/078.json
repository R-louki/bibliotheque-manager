{"n":78,"name":"النبأ","ayat":[{"n":1,"t":"عَمَّ يَتَسَآءَلُونَ","p":"582","h":[1]},{"n":2,"t":"عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ","p":"582","h":[2]},{"n":3,"t":"اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ","p":"582","h":[3]},{"n":4,"t":"كَلَّا سَيَعْلَمُونَ","p":"582","h":[4]},{"n":5,"t":"ثُمَّ كَلَّا سَيَعْلَمُونَۖ","p":"582","h":[5]},{"n":6,"t":"أَلَمْ نَجْعَلِ اِ۬لْأَرْضَ مِهَٰداٗ","p":"582","h":[6]},{"n":7,"t":"وَالْجِبَالَ أَوْتَاداٗ","p":"582","h":[7]},{"n":8,"t":"وَخَلَقْنَٰكُمْ أَزْوَٰجاٗ","p":"582","h":[8]},{"n":9,"t":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ","p":"582","h":[9]},{"n":10,"t":"وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ","p":"582","h":[10]},{"n":11,"t":"وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ","p":"582","h":[11]},{"n":12,"t":"وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ","p":"582","h":[12]},{"n":13,"t":"وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ","p":"582","h":[13]},{"n":14,"t":"وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ","p":"582","h":[14]},{"n":15,"t":"لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ","p":"582","h":[15]},{"n":16,"t":"وَجَنَّٰتٍ أَلْفَافاًۖ","p":"582","h":[16]},{"n":17,"t":"إِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ","p":"582","h":[17]},{"n":18,"t":"يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَأْتُونَ أَفْوَاجاٗ","p":"582","h":[18]},{"n":19,"t":"وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتْ أَبْوَاباٗ","p":"582","h":[19]},{"n":20,"t":"وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ","p":"582","h":[20]},{"n":21,"t":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ","p":"582","h":[21]},{"n":22,"t":"لِّلطَّٰغِينَ مَـَٔاباٗ","p":"582","h":[22]},{"n":23,"t":"لَّٰبِثِينَ فِيهَا أَحْقَاباٗۖ","p":"582","h":[23]},{"n":24,"t":"لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً","p":"582","h":[24]},{"n":25,"t":"إِلَّا حَمِيماٗ وَغَسَاقاٗ","p":"582","h":[25]},{"n":26,"t":"جَزَآءٗ وِفَاقاًۖ","p":"582","h":[26]},{"n":27,"t":"إِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ","p":"582","h":[27]},{"n":28,"t":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ","p":"582","h":[28]},{"n":29,"t":"وَكُلَّ شَےْءٍ أَحْصَيْنَٰهُ كِتَٰباٗۖ","p":"582","h":[29]},{"n":30,"t":"فَذُوقُواْ فَلَن نَّزِيدَكُمْ إِلَّا عَذَاباًۖ","p":"582","h":[30]},{"n":31,"t":"إِنَّ لِلْمُتَّقِينَ مَفَازاً","p":"583","h":[31]},{"n":32,"t":"حَدَآئِقَ وَأَعْنَٰباٗ","p":"583","h":[32]},{"n":33,"t":"وَكَوَاعِبَ أَتْرَاباٗ","p":"583","h":[33]},{"n":34,"t":"وَكَأْساٗ دِهَاقاٗ","p":"583","h":[34]},{"n":35,"t":"لَّا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا كِذَّاباٗۖ","p":"583","h":[35]},{"n":36,"t":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَاباٗۖ","p":"583","h":[36]},{"n":37,"t":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباٗۖ","p":"583","h":[37]},{"n":38,"t":"يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاٗ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباٗۖ","p":"583","h":[38]},{"n":39,"t":"ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔاباًۖ","p":"583","h":[39]},{"n":40,"t":"إِنَّا أَنذَرْنَٰكُمْ عَذَاباٗ قَرِيباٗ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباَۢۖ","p":"583","h":[40]}]}