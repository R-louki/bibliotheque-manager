{"n":84,"name":"الانشقاق","ayat":[{"n":1,"t":"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ","p":"589","h":[1]},{"n":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","p":"589","h":[2]},{"n":3,"t":"وَإِذَا اَ۬لْأَرْضُ مُدَّتْ","p":"589","h":[3]},{"n":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","p":"589","h":[4]},{"n":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ","p":"589","h":[5]},{"n":6,"t":"يَٰأَيُّهَا اَ۬لْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ","p":"589","h":[6]},{"n":7,"t":"فَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","p":"589","h":[7]},{"n":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ","p":"589","h":[8]},{"n":9,"t":"وَيَنقَلِبُ إِلَىٰ أَهْلِهِۦ مَسْرُوراٗۖ","p":"589","h":[9]},{"n":10,"t":"وَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","p":"589","h":[10]},{"n":11,"t":"فَسَوْفَ يَدْعُواْ ثُبُوراٗ","p":"589","h":[11]},{"n":12,"t":"وَيُصَلَّىٰ سَعِيراًۖ","p":"589","h":[12]},{"n":13,"t":"إِنَّهُۥ كَانَ فِے أَهْلِهِۦ مَسْرُوراًۖ","p":"589","h":[13]},{"n":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ","p":"589","h":[14]},{"n":15,"t":"بَلَىٰۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ","p":"589","h":[15]},{"n":16,"t":"۞ فَلَا أُقْسِمُ بِالشَّفَقِ","p":"589","h":[16]},{"n":17,"t":"وَاليْلِ وَمَا وَسَقَ","p":"589","h":[17]},{"n":18,"t":"وَالْقَمَرِ إِذَا اَ۪تَّسَقَ","p":"589","h":[18]},{"n":19,"t":"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ","p":"589","h":[19]},{"n":20,"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","p":"589","h":[20]},{"n":21,"t":"وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَۖ","p":"589","h":[21]},{"n":22,"t":"بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ","p":"589","h":[22]},{"n":23,"t":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ","p":"589","h":[23]},{"n":24,"t":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍۖ","p":"589","h":[24]},{"n":25,"t":"إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونِۢۖ","p":"590","h":[25]}]}