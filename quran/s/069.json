{"n":69,"name":"الحاقة","ayat":[{"n":1,"t":"اِ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ","p":"566","h":[1,2]},{"n":2,"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لْحَآقَّةُۖ","p":"566","h":[3]},{"n":3,"t":"كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ","p":"566","h":[4]},{"n":4,"t":"فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ","p":"566","h":[5]},{"n":5,"t":"وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ","p":"566","h":[6]},{"n":6,"t":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ","p":"566","h":[7]},{"n":7,"t":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖۖ","p":"566","h":[8]},{"n":8,"t":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُؤْتَفِكَٰتُ بِالْخَاطِئَةِ","p":"567","h":[9]},{"n":9,"t":"فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةٗ رَّابِيَةًۖ","p":"567","h":[10]},{"n":10,"t":"إِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ","p":"567","h":[11]},{"n":11,"t":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَا أُذْنٞ وَٰعِيَةٞۖ","p":"567","h":[12]},{"n":12,"t":"فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ","p":"567","h":[13]},{"n":13,"t":"وَحُمِلَتِ اِ۬لْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ","p":"567","h":[14]},{"n":14,"t":"فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ","p":"567","h":[15]},{"n":15,"t":"وَانشَقَّتِ اِ۬لسَّمَآءُ فَهْيَ يَوْمَئِذٖ وَاهِيَةٞ","p":"567","h":[16]},{"n":16,"t":"وَالْمَلَكُ عَلَىٰ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ","p":"567","h":[17]},{"n":17,"t":"يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٞۖ","p":"567","h":[18]},{"n":18,"t":"۞ فَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ","p":"567","h":[19]},{"n":19,"t":"إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ","p":"567","h":[20]},{"n":20,"t":"فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖ","p":"567","h":[21]},{"n":21,"t":"فِے جَنَّةٍ عَالِيَةٖ","p":"567","h":[22]},{"n":22,"t":"قُطُوفُهَا دَانِيَةٞۖ","p":"567","h":[23]},{"n":23,"t":"كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا أَسْلَفْتُمْ فِے اِ۬لْأَيَّامِ اِ۬لْخَالِيَةِۖ","p":"567","h":[24]},{"n":24,"t":"وَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ","p":"567","h":[25]},{"n":25,"t":"فَيَقُولُ يَٰلَيْتَنِے لَمْ أُوتَ كِتَٰبِيَهْۖ","p":"567","h":[25]},{"n":26,"t":"وَلَمْ أَدْرِ مَا حِسَابِيَهْۖ","p":"567","h":[26]},{"n":27,"t":"يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ","p":"567","h":[27]},{"n":28,"t":"مَا أَغْنَىٰ عَنِّے مَالِيَهۖ","p":"567","h":[28]},{"n":29,"t":"هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ","p":"567","h":[29]},{"n":30,"t":"خُذُوهُ فَغُلُّوهُ","p":"567","h":[30]},{"n":31,"t":"ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ","p":"567","h":[31]},{"n":32,"t":"ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ","p":"567","h":[32]},{"n":33,"t":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِاللَّهِ اِ۬لْعَظِيمِ","p":"567","h":[33]},{"n":34,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ","p":"567","h":[34]},{"n":35,"t":"فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ","p":"567","h":[35]},{"n":36,"t":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٖ","p":"568","h":[36]},{"n":37,"t":"لَّا يَأْكُلُهُۥ إِلَّا اَ۬لْخَٰطِـُٔونَۖ","p":"568","h":[37]},{"n":38,"t":"۞ فَلَا أُقْسِمُ بِمَا تُبْصِرُونَ","p":"568","h":[38]},{"n":39,"t":"وَمَا لَا تُبْصِرُونَ","p":"568","h":[39]},{"n":40,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ","p":"568","h":[40]},{"n":41,"t":"وَمَا هُوَ بِقَوْلِ شَاعِرٖ قَلِيلاٗ مَّا تُؤْمِنُونَ","p":"568","h":[41]},{"n":42,"t":"وَلَا بِقَوْلِ كَاهِنٖۖ قَلِيلاٗ مَّا تَذَّكَّرُونَۖ","p":"568","h":[42]},{"n":43,"t":"تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ","p":"568","h":[43]},{"n":44,"t":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ اَ۬لْأَقَاوِيلِ","p":"568","h":[44]},{"n":45,"t":"لَأَخَذْنَا مِنْهُ بِالْيَمِينِ","p":"568","h":[45]},{"n":46,"t":"ثُمَّ لَقَطَعْنَا مِنْهُ اُ۬لْوَتِينَ","p":"568","h":[46]},{"n":47,"t":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَۖ","p":"568","h":[47]},{"n":48,"t":"وَإِنَّهُۥ لَتَذْكِرَةٞ لِّلْمُتَّقِينَۖ","p":"568","h":[48]},{"n":49,"t":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَۖ","p":"568","h":[49]},{"n":50,"t":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى اَ۬لْكَٰفِرِينَۖ","p":"568","h":[50]},{"n":51,"t":"وَإِنَّهُۥ لَحَقُّ اُ۬لْيَقِينِۖ","p":"568","h":[51]},{"n":52,"t":"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ","p":"568","h":[52]}]}