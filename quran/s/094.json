{"n":94,"name":"الشرح","ayat":[{"n":1,"t":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","p":"596","h":[1]},{"n":2,"t":"وَوَضَعْنَا عَنكَ وِزْرَكَ","p":"596","h":[2]},{"n":3,"t":"اَ۬لذِے أَنقَضَ ظَهْرَكَ","p":"597","h":[3]},{"n":4,"t":"وَرَفَعْنَا لَكَ ذِكْرَكَۖ","p":"597","h":[4]},{"n":5,"t":"فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً","p":"597","h":[5]},{"n":6,"t":"إِنَّ مَعَ اَ۬لْعُسْرِ يُسْراٗۖ","p":"597","h":[6]},{"n":7,"t":"فَإِذَا فَرَغْتَ فَانصَبْ","p":"597","h":[7]},{"n":8,"t":"وَإِلَىٰ رَبِّكَ فَارْغَبۖ","p":"597","h":[8]}]}