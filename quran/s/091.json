{"n":91,"name":"الشمس","ayat":[{"n":1,"t":"وَالشَّمْسِ وَضُحَيٰهَا","p":"595","h":[1]},{"n":2,"t":"وَالْقَمَرِ إِذَا تَلَيٰهَا","p":"595","h":[2]},{"n":3,"t":"وَالنَّهَارِ إِذَا جَلَّيٰهَا","p":"595","h":[3]},{"n":4,"t":"وَاليْلِ إِذَا يَغْشَيٰهَا","p":"595","h":[4]},{"n":5,"t":"وَالسَّمَآءِ وَمَا بَنَيٰهَا","p":"595","h":[5]},{"n":6,"t":"وَالْأَرْضِ وَمَا طَحَيٰهَا","p":"595","h":[6]},{"n":7,"t":"وَنَفْسٖ وَمَا سَوَّيٰهَا","p":"595","h":[7]},{"n":8,"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا","p":"595","h":[8]},{"n":9,"t":"قَدْ أَفْلَحَ مَن زَكَّيٰهَا","p":"595","h":[9]},{"n":10,"t":"وَقَدْ خَابَ مَن دَسَّيٰهَاۖ","p":"595","h":[10]},{"n":11,"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَا","p":"595","h":[11]},{"n":12,"t":"إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا","p":"595","h":[12]},{"n":13,"t":"فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا","p":"595","h":[13]},{"n":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ","p":"595","h":[14]},{"n":15,"t":"فَلَا يَخَافُ عُقْبَٰهَاۖ","p":"595","h":[15]}]}