{"n":1,"name":"الفاتحة","ayat":[{"n":1,"t":"اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ","p":"1","h":[1,2]},{"n":2,"t":"اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ","p":"1","h":[3]},{"n":3,"t":"مَلِكِ يَوْمِ اِ۬لدِّينِۖ","p":"1","h":[4]},{"n":4,"t":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ","p":"1","h":[5]},{"n":5,"t":"اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ","p":"1","h":[6]},{"n":6,"t":"صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ","p":"1","h":[7]},{"n":7,"t":"غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ","p":"1","h":[7]}]}