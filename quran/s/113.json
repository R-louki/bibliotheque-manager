{"n":113,"name":"الفلق","ayat":[{"n":1,"t":"قُلْ أَعُوذُ بِرَبِّ اِ۬لْفَلَقِ","p":"604","h":[1]},{"n":2,"t":"مِن شَرِّ مَا خَلَقَ","p":"604","h":[2]},{"n":3,"t":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","p":"604","h":[3]},{"n":4,"t":"وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ","p":"604","h":[4]},{"n":5,"t":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَۖ","p":"604","h":[5]}]}