{"n":88,"name":"الغاشية","ayat":[{"n":1,"t":"هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ","p":"592","h":[1]},{"n":2,"t":"وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ","p":"592","h":[2]},{"n":3,"t":"عَامِلَةٞ نَّاصِبَةٞ","p":"592","h":[3]},{"n":4,"t":"تَصْلَىٰ نَاراً حَامِيَةٗ","p":"592","h":[4]},{"n":5,"t":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٖۖ","p":"592","h":[5]},{"n":6,"t":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٖ","p":"592","h":[6]},{"n":7,"t":"لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ","p":"592","h":[7]},{"n":8,"t":"وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ","p":"592","h":[8]},{"n":9,"t":"لِّسَعْيِهَا رَاضِيَةٞ","p":"592","h":[9]},{"n":10,"t":"فِے جَنَّةٍ عَالِيَةٖ","p":"592","h":[10]},{"n":11,"t":"لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ","p":"592","h":[11]},{"n":12,"t":"فِيهَا عَيْنٞ جَارِيَةٞۖ","p":"592","h":[12]},{"n":13,"t":"فِيهَا سُرُرٞ مَّرْفُوعَةٞ","p":"592","h":[13]},{"n":14,"t":"وَأَكْوَابٞ مَّوْضُوعَةٞ","p":"592","h":[14]},{"n":15,"t":"وَنَمَارِقُ مَصْفُوفَةٞ","p":"592","h":[15]},{"n":16,"t":"وَزَرَابِيُّ مَبْثُوثَةٌۖ","p":"592","h":[16]},{"n":17,"t":"۞ أَفَلَا يَنظُرُونَ إِلَى اَ۬لْإِبِلِ كَيْفَ خُلِقَتْ","p":"592","h":[17]},{"n":18,"t":"وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ","p":"592","h":[18]},{"n":19,"t":"وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ","p":"592","h":[19]},{"n":20,"t":"وَإِلَى اَ۬لْأَرْضِ كَيْفَ سُطِحَتْۖ","p":"592","h":[20]},{"n":21,"t":"فَذَكِّرْ إِنَّمَا أَنتَ مُذَكِّرٞۖ","p":"592","h":[21]},{"n":22,"t":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ","p":"592","h":[22]},{"n":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","p":"593","h":[23]},{"n":24,"t":"فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لْعَذَابَ اَ۬لْأَكْبَرَۖ","p":"593","h":[24]},{"n":25,"t":"إِنَّ إِلَيْنَا إِيَابَهُمْ","p":"593","h":[25]},{"n":26,"t":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمۖ","p":"593","h":[26]}]}