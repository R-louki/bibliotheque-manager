{"n":82,"name":"الانفطار","ayat":[{"n":1,"t":"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ","p":"587","h":[1]},{"n":2,"t":"وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ","p":"587","h":[2]},{"n":3,"t":"وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ","p":"587","h":[3]},{"n":4,"t":"وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ","p":"587","h":[4]},{"n":5,"t":"عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ","p":"587","h":[5]},{"n":6,"t":"يَٰأَيُّهَا اَ۬لْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ","p":"587","h":[6]},{"n":7,"t":"اِ۬لذِے خَلَقَكَ فَسَوَّيٰكَ فَعَدَّلَكَ","p":"587","h":[7]},{"n":8,"t":"فِے أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ","p":"587","h":[8]},{"n":9,"t":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ","p":"587","h":[9]},{"n":10,"t":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","p":"587","h":[10]},{"n":11,"t":"كِرَاماٗ كَٰتِبِينَ","p":"587","h":[11]},{"n":12,"t":"يَعْلَمُونَ مَا تَفْعَلُونَۖ","p":"587","h":[12]},{"n":13,"t":"إِنَّ اَ۬لْأَبْرَارَ لَفِے نَعِيمٖۖ","p":"587","h":[13]},{"n":14,"t":"وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ","p":"587","h":[14]},{"n":15,"t":"يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ","p":"587","h":[15]},{"n":16,"t":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ","p":"587","h":[16]},{"n":17,"t":"وَمَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لدِّينِ","p":"587","h":[17]},{"n":18,"t":"ثُمَّ مَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لدِّينِۖ","p":"587","h":[18]},{"n":19,"t":"يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَئْاٗۖ وَالْأَمْرُ يَوْمَئِذٖ لِّلهِۖ","p":"587","h":[19]}]}