{"n":93,"name":"الضحى","ayat":[{"n":1,"t":"وَالضُّحَىٰ","p":"596","h":[1]},{"n":2,"t":"وَاليْلِ إِذَا سَجَىٰ","p":"596","h":[2]},{"n":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰۖ","p":"596","h":[3]},{"n":4,"t":"وَلَلْأٓخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لْأُولَىٰۖ","p":"596","h":[4]},{"n":5,"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰۖ","p":"596","h":[5]},{"n":6,"t":"أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاوَىٰ","p":"596","h":[6]},{"n":7,"t":"وَوَجَدَكَ ضَآلّاٗ فَهَدَىٰ","p":"596","h":[7]},{"n":8,"t":"وَوَجَدَكَ عَآئِلاٗ فَأَغْنَىٰۖ","p":"596","h":[8]},{"n":9,"t":"فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ","p":"596","h":[9]},{"n":10,"t":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ","p":"596","h":[10]},{"n":11,"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْۖ","p":"596","h":[11]}]}