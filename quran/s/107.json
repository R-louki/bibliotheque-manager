{"n":107,"name":"الماعون","ayat":[{"n":1,"t":"أَرَٰ۬يْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ","p":"602","h":[1]},{"n":2,"t":"فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ","p":"602","h":[2]},{"n":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ","p":"602","h":[3]},{"n":4,"t":"فَوَيْلٞ لِّلْمُصَلِّينَ","p":"602","h":[4]},{"n":5,"t":"اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","p":"602","h":[5]},{"n":6,"t":"اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ","p":"602","h":[6,7]}]}