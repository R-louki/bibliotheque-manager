{"n":99,"name":"الزلزلة","ayat":[{"n":1,"t":"إِذَا زُلْزِلَتِ اِ۬لْأَرْضُ زِلْزَالَهَا","p":"599","h":[1]},{"n":2,"t":"وَأَخْرَجَتِ اِ۬لْأَرْضُ أَثْقَالَهَا","p":"599","h":[2]},{"n":3,"t":"وَقَالَ اَ۬لْإِنسَٰنُ مَا لَهَا","p":"599","h":[3]},{"n":4,"t":"يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا","p":"599","h":[4]},{"n":5,"t":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَاۖ","p":"599","h":[5]},{"n":6,"t":"يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ","p":"599","h":[6]},{"n":7,"t":"لِّيُرَوْاْ أَعْمَٰلَهُمْۖ","p":"599","h":[6]},{"n":8,"t":"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ","p":"599","h":[7]},{"n":9,"t":"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ","p":"599","h":[8]}]}