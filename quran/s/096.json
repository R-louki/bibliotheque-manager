{"n":96,"name":"العلق","ayat":[{"n":1,"t":"اِ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ","p":"597","h":[1]},{"n":2,"t":"خَلَقَ اَ۬لْإِنسَٰنَ مِنْ عَلَقٍۖ","p":"597","h":[2]},{"n":3,"t":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لْأَكْرَمُ","p":"597","h":[3]},{"n":4,"t":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ","p":"597","h":[4]},{"n":5,"t":"عَلَّمَ اَ۬لْإِنسَٰنَ مَا لَمْ يَعْلَمْۖ","p":"597","h":[5]},{"n":6,"t":"كَلَّا إِنَّ اَ۬لْإِنسَٰنَ لَيَطْغَىٰ","p":"597","h":[6]},{"n":7,"t":"أَن رَّءَاهُ اُ۪سْتَغْنَىٰۖ","p":"597","h":[7]},{"n":8,"t":"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْعَىٰۖ","p":"597","h":[8]},{"n":9,"t":"أَرَٰ۬يْتَ اَ۬لذِے يَنْهَىٰ","p":"597","h":[9]},{"n":10,"t":"عَبْداً إِذَا صَلَّىٰۖ","p":"597","h":[10]},{"n":11,"t":"أَرَٰ۬يْتَ إِن كَانَ عَلَى اَ۬لْهُدَىٰ","p":"597","h":[11]},{"n":12,"t":"أَوْ أَمَرَ بِالتَّقْوَىٰ","p":"597","h":[12]},{"n":13,"t":"أَرَٰ۬يْتَ إِن كَذَّبَ وَتَوَلَّىٰ","p":"598","h":[13]},{"n":14,"t":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَرَىٰۖ","p":"598","h":[14]},{"n":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ","p":"598","h":[15]},{"n":16,"t":"لَنَسْفَعاَۢ بِالنَّاصِيَةِ","p":"598","h":[15]},{"n":17,"t":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖۖ","p":"598","h":[16]},{"n":18,"t":"فَلْيَدْعُ نَادِيَهُۥ","p":"598","h":[17]},{"n":19,"t":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ","p":"598","h":[18]},{"n":20,"t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبۖ","p":"598","h":[19]}]}