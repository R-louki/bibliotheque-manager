{"n":104,"name":"الهمزة","ayat":[{"n":1,"t":"وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","p":"601","h":[1]},{"n":2,"t":"اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ","p":"601","h":[2]},{"n":3,"t":"يَحْسِبُ أَنَّ مَالَهُۥ أَخْلَدَهُۥ","p":"601","h":[3]},{"n":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ","p":"601","h":[4]},{"n":5,"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لْحُطَمَةُۖ","p":"601","h":[5]},{"n":6,"t":"نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ","p":"601","h":[6]},{"n":7,"t":"اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لْأَفْـِٕدَةِۖ","p":"601","h":[7]},{"n":8,"t":"إِنَّهَا عَلَيْهِم مُّوصَدَةٞ","p":"601","h":[8]},{"n":9,"t":"فِے عَمَدٖ مُّمَدَّدَةِۢۖ","p":"601","h":[9]}]}