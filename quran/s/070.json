{"n":70,"name":"المعارج","ayat":[{"n":1,"t":"سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ","p":"568","h":[1]},{"n":2,"t":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٞ","p":"568","h":[2]},{"n":3,"t":"مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ","p":"568","h":[3]},{"n":4,"t":"تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ","p":"568","h":[4]},{"n":5,"t":"فَاصْبِرْ صَبْراٗ جَمِيلاًۖ","p":"568","h":[5]},{"n":6,"t":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ","p":"568","h":[6]},{"n":7,"t":"وَنَرَيٰهُ قَرِيباٗۖ","p":"568","h":[7]},{"n":8,"t":"يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ","p":"568","h":[8]},{"n":9,"t":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ","p":"568","h":[9]},{"n":10,"t":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيماٗ","p":"568","h":[10]},{"n":11,"t":"يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ","p":"569","h":[11]},{"n":12,"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","p":"569","h":[12]},{"n":13,"t":"وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ","p":"569","h":[13]},{"n":14,"t":"وَمَن فِے اِ۬لْأَرْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ","p":"569","h":[14]},{"n":15,"t":"كَلَّاۖ إِنَّهَا لَظَىٰ","p":"569","h":[15]},{"n":16,"t":"نَزَّاعَةٞ لِّلشَّوَىٰ","p":"569","h":[16]},{"n":17,"t":"تَدْعُواْ مَنْ أَدْبَرَ وَتَوَلَّىٰ","p":"569","h":[17]},{"n":18,"t":"وَجَمَعَ فَأَوْعَىٰۖ","p":"569","h":[18]},{"n":19,"t":"۞ إِنَّ اَ۬لْإِنسَٰنَ خُلِقَ هَلُوعاً","p":"569","h":[19]},{"n":20,"t":"إِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ","p":"569","h":[20]},{"n":21,"t":"وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً","p":"569","h":[21]},{"n":22,"t":"إِلَّا اَ۬لْمُصَلِّينَ","p":"569","h":[22]},{"n":23,"t":"اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ","p":"569","h":[23]},{"n":24,"t":"وَالذِينَ فِے أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ","p":"569","h":[24]},{"n":25,"t":"لِّلسَّآئِلِ وَالْمَحْرُومِۖ","p":"569","h":[25]},{"n":26,"t":"وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ","p":"569","h":[26]},{"n":27,"t":"وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","p":"569","h":[27]},{"n":28,"t":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٖۖ","p":"569","h":[28]},{"n":29,"t":"وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","p":"569","h":[29]},{"n":30,"t":"إِلَّا عَلَىٰ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ","p":"569","h":[30]},{"n":31,"t":"فَمَنِ اِ۪بْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ","p":"569","h":[31]},{"n":32,"t":"وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ","p":"569","h":[32]},{"n":33,"t":"وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ","p":"569","h":[33]},{"n":34,"t":"وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","p":"569","h":[34]},{"n":35,"t":"أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ","p":"569","h":[35]},{"n":36,"t":"فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ","p":"569","h":[36]},{"n":37,"t":"عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ","p":"569","h":[37]},{"n":38,"t":"أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمْ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ","p":"569","h":[38]},{"n":39,"t":"كَلَّاۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ","p":"569","h":[39]},{"n":40,"t":"۞ فَلَا أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","p":"569","h":[40]},{"n":41,"t":"عَلَىٰ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ","p":"570","h":[41]},{"n":42,"t":"فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ","p":"570","h":[42]},{"n":43,"t":"يَوْمَ يَخْرُجُونَ مِنَ اَ۬لْأَجْدَاثِ سِرَاعاٗ كَأَنَّهُمْ إِلَىٰ نَصْبٖ يُوفِضُونَ","p":"570","h":[43]},{"n":44,"t":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ","p":"570","h":[44]}]}