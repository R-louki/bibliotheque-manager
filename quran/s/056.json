ِے سِدْرٖ مَّخْضُودٖ","p":"535","h":[28]},{"n":31,"t":"وَطَلْحٖ مَّنضُودٖ","p":"535","h":[29]},{"n":32,"t":"وَظِلّٖ مَّمْدُودٖ","p":"535","h":[30]},{"n":33,"t":"وَمَآءٖ مَّسْكُوبٖ","p":"535","h":[31]},{"n":34,"t":"وَفَٰكِهَةٖ كَثِيرَةٖ","p":"535","h":[32]},{"n":35,"t":"لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ","p":"535","h":[33]},{"n":36,"t":"وَفُرُشٖ مَّرْفُوعَةٍۖ","p":"535","h":[34]},{"n":37,"t":"إِنَّا أَنشَأْنَٰهُنَّ إِنشَآءٗ","p":"535","h":[35]},{"n":38,"t":"فَجَعَلْنَٰهُنَّ أَبْكَاراً","p":"535","h":[36]},{"n":39,"t":"عُرُباً أَتْرَاباٗ","p":"535","h":[37]},{"n":40,"t":"لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ","p":"535","h":[38]},{"n":41,"t":"ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ","p":"535","h":[39]},{"n":42,"t":"وَثُلَّةٞ مِّنَ اَ۬لْأٓخِرِينَۖ","p":"535","h":[40]},{"n":43,"t":"وَأَصْحَٰبُ اُ۬لشِّمَالِ","p":"535","h":[41]},{"n":44,"t":"مَا أَصْحَٰبُ اُ۬لشِّمَالِۖ","p":"535","h":[41]},{"n":45,"t":"فِے سَمُومٖ وَحَمِيمٖ","p":"535","h":[42]},{"n":46,"t":"وَظِلّٖ مِّنْ يَّحْمُومٖ","p":"535","h":[43]},{"n":47,"t":"لَّا بَارِدٖ وَلَا كَرِيمٍۖ","p":"535","h":[44]},{"n":48,"t":"إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ","p":"535","h":[45]},{"n":49,"t":"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ","p":"535","h":[46]},{"n":50,"t":"وَكَانُواْ يَقُولُونَ أَٰئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ","p":"535","h":[47]},{"n":51,"t":"أَوْ ءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ","p":"535","h":[48]},{"n":52,"t":"۞ قُلْ إِنَّ اَ۬لْأَوَّلِينَ وَالْأٓخِرِينَ لَمَجْمُوعُونَ","p":"535","h":[49,50]},{"n":53,"t":"إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ","p":"535","h":[50]},{"n":54,"t":"ثُمَّ إِنَّكُمْ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ","p":"536","h":[51]},{"n":55,"t":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","p":"536","h":[52]},{"n":56,"t":"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ","p":"536","h":[53]},{"n":57,"t":"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ","p":"536","h":[54]},{"n":58,"t":"فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ","p":"536","h":[55]},{"n":59,"t":"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّي