{"n":90,"name":"البلد","ayat":[{"n":1,"t":"لَا أُقْسِمُ بِهَٰذَا اَ۬لْبَلَدِ","p":"594","h":[1]},{"n":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لْبَلَدِ","p":"594","h":[2]},{"n":3,"t":"وَوَالِدٖ وَمَا وَلَدَ","p":"594","h":[3]},{"n":4,"t":"لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے كَبَدٍۖ","p":"594","h":[4]},{"n":5,"t":"أَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدٞ","p":"594","h":[5]},{"n":6,"t":"يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ","p":"594","h":[6]},{"n":7,"t":"أَيَحْسِبُ أَن لَّمْ يَرَهُۥ أَحَدٌۖ","p":"594","h":[7]},{"n":8,"t":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","p":"594","h":[8]},{"n":9,"t":"وَلِسَاناٗ وَشَفَتَيْنِ","p":"594","h":[9]},{"n":10,"t":"وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ","p":"594","h":[10]},{"n":11,"t":"فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ","p":"594","h":[11]},{"n":12,"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لْعَقَبَةُۖ","p":"594","h":[12]},{"n":13,"t":"فَكُّ رَقَبَةٍ","p":"594","h":[13]},{"n":14,"t":"أَوْ إِطْعَامٞ فِے يَوْمٖ ذِے مَسْغَبَةٖ","p":"594","h":[14]},{"n":15,"t":"يَتِيماٗ ذَا مَقْرَبَةٍ","p":"594","h":[15]},{"n":16,"t":"أَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ","p":"594","h":[16]},{"n":17,"t":"ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ","p":"594","h":[17]},{"n":18,"t":"أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ","p":"594","h":[18]},{"n":19,"t":"وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ","p":"595","h":[19]},{"n":20,"t":"عَلَيْهِمْ نَارٞ مُّوصَدَةُۢۖ","p":"595","h":[20]}]}