{"n":79,"name":"النازعات","ayat":[{"n":1,"t":"وَالنَّٰزِعَٰتِ غَرْقاٗ","p":"583","h":[1]},{"n":2,"t":"وَالنَّٰشِطَٰتِ نَشْطاٗ","p":"583","h":[2]},{"n":3,"t":"وَالسَّٰبِحَٰتِ سَبْحاٗ","p":"583","h":[3]},{"n":4,"t":"فَالسَّٰبِقَٰتِ سَبْقاٗ","p":"583","h":[4]},{"n":5,"t":"فَالْمُدَبِّرَٰتِ أَمْراٗ","p":"583","h":[5]},{"n":6,"t":"يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ","p":"583","h":[6]},{"n":7,"t":"تَتْبَعُهَا اَ۬لرَّادِفَةُۖ","p":"583","h":[7]},{"n":8,"t":"قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ","p":"583","h":[8]},{"n":9,"t":"أَبْصَٰرُهَا خَٰشِعَةٞۖ","p":"583","h":[9]},{"n":10,"t":"يَقُولُونَ أَٰ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ","p":"583","h":[10]},{"n":11,"t":"إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ","p":"583","h":[11]},{"n":12,"t":"قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ","p":"583","h":[12]},{"n":13,"t":"فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ","p":"583","h":[13]},{"n":14,"t":"فَإِذَا هُم بِالسَّاهِرَةِۖ","p":"583","h":[14]},{"n":15,"t":"هَلْ أَتَيٰكَ حَدِيثُ مُوسَىٰ","p":"583","h":[15]},{"n":16,"t":"إِذْ نَادَيٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ","p":"583","h":[16]},{"n":17,"t":"اَ۪ذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","p":"584","h":[17]},{"n":18,"t":"فَقُلْ هَل لَّكَ إِلَىٰ أَن تَزَّكَّىٰ","p":"584","h":[18]},{"n":19,"t":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰۖ","p":"584","h":[19]},{"n":20,"t":"فَأَرَيٰهُ اُ۬لْأٓيَةَ اَ۬لْكُبْرَىٰ","p":"584","h":[20]},{"n":21,"t":"فَكَذَّبَ وَعَصَىٰ","p":"584","h":[21]},{"n":22,"t":"ثُمَّ أَدْبَرَ يَسْعَىٰ","p":"584","h":[22]},{"n":23,"t":"فَحَشَرَ فَنَادَىٰ","p":"584","h":[23]},{"n":24,"t":"فَقَالَ أَنَا رَبُّكُمُ اُ۬لْأَعْلَىٰ","p":"584","h":[24]},{"n":25,"t":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لْأٓخِرَةِ وَالْأُولَىٰۖ","p":"584","h":[25]},{"n":26,"t":"إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْشَىٰۖ","p":"584","h":[26]},{"n":27,"t":"ءَٰا۬نتُمْ أَشَدُّ خَلْقاً أَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا","p":"584","h":[27]},{"n":28,"t":"رَفَعَ سَمْكَهَا فَسَوَّيٰهَا","p":"584","h":[28]},{"n":29,"t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ","p":"584","h":[29]},{"n":30,"t":"وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَا","p":"584","h":[30]},{"n":31,"t":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا","p":"584","h":[31]},{"n":32,"t":"وَالْجِبَالَ أَرْسَيٰهَا","p":"584","h":[32]},{"n":33,"t":"مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ","p":"584","h":[33]},{"n":34,"t":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْرَىٰ","p":"584","h":[34]},{"n":35,"t":"يَوْمَ يَتَذَكَّرُ اُ۬لْإِنسَٰنُ مَا سَعَىٰ","p":"584","h":[35]},{"n":36,"t":"وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّرَىٰۖ","p":"584","h":[36]},{"n":37,"t":"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا","p":"584","h":[37,38]},{"n":38,"t":"فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْوَىٰۖ","p":"584","h":[39]},{"n":39,"t":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَوَىٰ","p":"584","h":[40]},{"n":40,"t":"فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْوَىٰۖ","p":"584","h":[41]},{"n":41,"t":"۞ يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ","p":"584","h":[42]},{"n":42,"t":"فِيمَ أَنتَ مِن ذِكْرَيٰهَاۖ","p":"584","h":[43]},{"n":43,"t":"إِلَىٰ رَبِّكَ مُنتَهَيٰهَاۖ","p":"584","h":[44]},{"n":44,"t":"إِنَّمَا أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ","p":"584","h":[45]},{"n":45,"t":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُواْ إِلَّا عَشِيَّةً أَوْ ضُحَيٰهَاۖ","p":"584","h":[46]}]}