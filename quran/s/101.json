{"n":101,"name":"القارعة","ayat":[{"n":1,"t":"اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ","p":"600","h":[1,2]},{"n":2,"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لْقَارِعَةُۖ","p":"600","h":[3]},{"n":3,"t":"يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ","p":"600","h":[4]},{"n":4,"t":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ","p":"600","h":[5]},{"n":5,"t":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","p":"600","h":[6]},{"n":6,"t":"فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖۖ","p":"600","h":[7]},{"n":7,"t":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","p":"600","h":[8]},{"n":8,"t":"فَأُمُّهُۥ هَاوِيَةٞۖ","p":"600","h":[9]},{"n":9,"t":"وَمَا أَدْرَيٰكَ مَا هِيَهْۖ","p":"600","h":[10]},{"n":10,"t":"نَارٌ حَامِيَةُۢۖ","p":"600","h":[11]}]}