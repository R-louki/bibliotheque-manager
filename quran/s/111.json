{"n":111,"name":"المسد","ayat":[{"n":1,"t":"تَبَّتْ يَدَا أَبِے لَهَبٖ وَتَبَّۖ","p":"603","h":[1]},{"n":2,"t":"مَا أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَۖ","p":"603","h":[2]},{"n":3,"t":"سَيَصْلَىٰ نَاراٗ ذَاتَ لَهَبٖ","p":"603","h":[3]},{"n":4,"t":"وَامْرَأَتُهُۥۖ حَمَّالَةُ اُ۬لْحَطَبِ","p":"603","h":[4]},{"n":5,"t":"فِے جِيدِهَا حَبْلٞ مِّن مَّسَدِۢۖ","p":"603","h":[5]}]}