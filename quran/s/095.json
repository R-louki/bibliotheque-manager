{"n":95,"name":"التين","ayat":[{"n":1,"t":"وَالتِّينِ وَالزَّيْتُونِ","p":"597","h":[1]},{"n":2,"t":"وَطُورِ سِينِينَ","p":"597","h":[2]},{"n":3,"t":"وَهَٰذَا اَ۬لْبَلَدِ اِ۬لْأَمِينِ","p":"597","h":[3]},{"n":4,"t":"لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے أَحْسَنِ تَقْوِيمٖ","p":"597","h":[4]},{"n":5,"t":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","p":"597","h":[5]},{"n":6,"t":"إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٖۖ","p":"597","h":[6]},{"n":7,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ","p":"597","h":[7]},{"n":8,"t":"أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ","p":"597","h":[8]}]}