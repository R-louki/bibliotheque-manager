{"n":75,"name":"القيامة","ayat":[{"n":1,"t":"لَا أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ","p":"577","h":[1]},{"n":2,"t":"وَلَا أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ","p":"577","h":[2]},{"n":3,"t":"أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","p":"577","h":[3]},{"n":4,"t":"بَلَىٰۖ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥۖ","p":"577","h":[4]},{"n":5,"t":"بَلْ يُرِيدُ اُ۬لْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ","p":"577","h":[5]},{"n":6,"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ","p":"577","h":[6]},{"n":7,"t":"فَإِذَا بَرَقَ اَ۬لْبَصَرُ","p":"577","h":[7]},{"n":8,"t":"وَخَسَفَ اَ۬لْقَمَرُ","p":"577","h":[8]},{"n":9,"t":"وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ","p":"577","h":[9]},{"n":10,"t":"يَقُولُ اُ۬لْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ اَ۬لْمَفَرُّۖ","p":"577","h":[10]},{"n":11,"t":"كَلَّا لَا وَزَرَۖ","p":"577","h":[11]},{"n":12,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ","p":"577","h":[12]},{"n":13,"t":"يُنَبَّؤُاْ اُ۬لْإِنسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ","p":"577","h":[13]},{"n":14,"t":"بَلِ اِ۬لْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ","p":"577","h":[14]},{"n":15,"t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥۖ","p":"577","h":[15]},{"n":16,"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ","p":"577","h":[16,17]},{"n":17,"t":"فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ","p":"577","h":[18]},{"n":18,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ","p":"577","h":[19]},{"n":19,"t":"كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ","p":"578","h":[20]},{"n":20,"t":"وَتَذَرُونَ اَ۬لْأٓخِرَةَۖ","p":"578","h":[21]},{"n":21,"t":"وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ","p":"578","h":[22]},{"n":22,"t":"إِلَىٰ رَبِّهَا نَاظِرَةٞۖ","p":"578","h":[23]},{"n":23,"t":"وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ","p":"578","h":[24]},{"n":24,"t":"تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ","p":"578","h":[25]},{"n":25,"t":"كَلَّا إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ","p":"578","h":[26]},{"n":26,"t":"وَقِيلَ مَن رَّاقٖ","p":"578","h":[27]},{"n":27,"t":"وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ","p":"578","h":[28]},{"n":28,"t":"وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ","p":"578","h":[29]},{"n":29,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ","p":"578","h":[30]},{"n":30,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰۖ","p":"578","h":[31]},{"n":31,"t":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰۖ","p":"578","h":[32]},{"n":32,"t":"ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِۦ يَتَمَطَّىٰۖ","p":"578","h":[33]},{"n":33,"t":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","p":"578","h":[34]},{"n":34,"t":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰۖ","p":"578","h":[35]},{"n":35,"t":"أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ","p":"578","h":[36]},{"n":36,"t":"أَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْنَىٰ","p":"578","h":[37]},{"n":37,"t":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ","p":"578","h":[38]},{"n":38,"t":"فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالْأُنثَىٰۖ","p":"578","h":[39]},{"n":39,"t":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَنْ يُّحْـِۧيَ اَ۬لْمَوْتَىٰۖ","p":"578","h":[40]}]}