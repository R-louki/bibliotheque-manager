{"n":105,"name":"الفيل","ayat":[{"n":1,"t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ","p":"601","h":[1]},{"n":2,"t":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ","p":"601","h":[2]},{"n":3,"t":"وَأَرْسَلَ عَلَيْهِمْ طَيْراً أَبَابِيلَ","p":"601","h":[3]},{"n":4,"t":"تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ","p":"601","h":[4]},{"n":5,"t":"فَجَعَلَهُمْ كَعَصْفٖ مَّأْكُولِۢۖ","p":"601","h":[5]}]}