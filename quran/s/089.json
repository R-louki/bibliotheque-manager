{"n":89,"name":"الفجر","ayat":[{"n":1,"t":"وَالْفَجْرِ","p":"593","h":[1]},{"n":2,"t":"وَلَيَالٍ عَشْرٖ","p":"593","h":[2]},{"n":3,"t":"وَالشَّفْعِ وَالْوَتْرِ","p":"593","h":[3]},{"n":4,"t":"وَاليْلِ إِذَا يَسْرِۦ","p":"593","h":[4]},{"n":5,"t":"هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ","p":"593","h":[5]},{"n":6,"t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","p":"593","h":[6]},{"n":7,"t":"إِرَمَ ذَاتِ اِ۬لْعِمَادِ","p":"593","h":[7]},{"n":8,"t":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ","p":"593","h":[8]},{"n":9,"t":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِ","p":"593","h":[9]},{"n":10,"t":"وَفِرْعَوْنَ ذِے اِ۬لْأَوْتَادِ","p":"593","h":[10]},{"n":11,"t":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ","p":"593","h":[11]},{"n":12,"t":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ","p":"593","h":[12]},{"n":13,"t":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ","p":"593","h":[13]},{"n":14,"t":"إِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ","p":"593","h":[14]},{"n":15,"t":"فَأَمَّا اَ۬لْإِنسَٰنُ إِذَا مَا اَ۪بْتَلَيٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ","p":"593","h":[15]},{"n":16,"t":"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ","p":"593","h":[15]},{"n":17,"t":"وَأَمَّا إِذَا مَا اَ۪بْتَلَيٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ","p":"593","h":[16]},{"n":18,"t":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ","p":"593","h":[16]},{"n":19,"t":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ","p":"593","h":[17]},{"n":20,"t":"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ","p":"593","h":[18]},{"n":21,"t":"وَتَأْكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ","p":"593","h":[19]},{"n":22,"t":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ","p":"593","h":[20]},{"n":23,"t":"كَلَّاۖ إِذَا دُكَّتِ اِ۬لْأَرْضُ دَكّاٗ دَكّاٗ","p":"593","h":[21]},{"n":24,"t":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ","p":"593","h":[22]},{"n":25,"t":"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ","p":"594","h":[23]},{"n":26,"t":"يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لْإِنسَٰنُ وَأَنَّىٰ لَهُ اُ۬لذِّكْرَىٰۖ","p":"594","h":[23]},{"n":27,"t":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ","p":"594","h":[24]},{"n":28,"t":"فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدٞ","p":"594","h":[25]},{"n":29,"t":"وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدٞۖ","p":"594","h":[26]},{"n":30,"t":"يَٰأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ","p":"594","h":[27]},{"n":31,"t":"اُ۪رْجِعِے إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ","p":"594","h":[28]},{"n":32,"t":"فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ","p":"594","h":[29,30]}]}