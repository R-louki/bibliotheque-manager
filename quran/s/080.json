{"n":80,"name":"عبس","ayat":[{"n":1,"t":"عَبَسَ وَتَوَلَّىٰ","p":"585","h":[1]},{"n":2,"t":"أَن جَآءَهُ اُ۬لْأَعْمَىٰۖ","p":"585","h":[2]},{"n":3,"t":"وَمَا يُدْرِيكَۖ لَعَلَّهُۥ يَزَّكَّىٰ","p":"585","h":[3]},{"n":4,"t":"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْرَىٰۖ","p":"585","h":[4]},{"n":5,"t":"أَمَّا مَنِ اِ۪سْتَغْنَىٰ","p":"585","h":[5]},{"n":6,"t":"فَأَنتَ لَهُۥ تَصَّدَّىٰ","p":"585","h":[6]},{"n":7,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰۖ","p":"585","h":[7]},{"n":8,"t":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","p":"585","h":[8]},{"n":9,"t":"وَهْوَ يَخْشَىٰ","p":"585","h":[9]},{"n":10,"t":"فَأَنتَ عَنْهُ تَلَهَّىٰ","p":"585","h":[10]},{"n":11,"t":"كَلَّاۖ إِنَّهَا تَذْكِرَةٞۖ","p":"585","h":[11]},{"n":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ","p":"585","h":[12]},{"n":13,"t":"فِے صُحُفٖ مُّكَرَّمَةٖ","p":"585","h":[13]},{"n":14,"t":"مَّرْفُوعَةٖ مُّطَهَّرَةِۢ","p":"585","h":[14]},{"n":15,"t":"بِأَيْدِے سَفَرَةٖ","p":"585","h":[15]},{"n":16,"t":"كِرَامِۢ بَرَرَةٖۖ","p":"585","h":[16]},{"n":17,"t":"قُتِلَ اَ۬لْإِنسَٰنُ مَا أَكْفَرَهُۥۖ","p":"585","h":[17]},{"n":18,"t":"مِنْ أَيِّ شَےْءٍ خَلَقَهُۥۖ","p":"585","h":[18]},{"n":19,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","p":"585","h":[19]},{"n":20,"t":"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ","p":"585","h":[20]},{"n":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ","p":"585","h":[21]},{"n":22,"t":"ثُمَّ إِذَا شَا أَنشَرَهُۥۖ","p":"585","h":[22]},{"n":23,"t":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُۥۖ","p":"585","h":[23]},{"n":24,"t":"فَلْيَنظُرِ اِ۬لْإِنسَٰنُ إِلَىٰ طَعَامِهِۦۖ","p":"585","h":[24]},{"n":25,"t":"إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ","p":"585","h":[25]},{"n":26,"t":"ثُمَّ شَقَقْنَا اَ۬لْأَرْضَ شَقّاٗ","p":"585","h":[26]},{"n":27,"t":"فَأَنۢبَتْنَا فِيهَا حَبّاٗ","p":"585","h":[27]},{"n":28,"t":"وَعِنَباٗ وَقَضْباٗ","p":"585","h":[28]},{"n":29,"t":"وَزَيْتُوناٗ وَنَخْلاٗ","p":"585","h":[29]},{"n":30,"t":"وَحَدَآئِقَ غُلْباٗ","p":"585","h":[30]},{"n":31,"t":"وَفَٰكِهَةٗ وَأَبّاٗ","p":"585","h":[31]},{"n":32,"t":"مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ","p":"585","h":[32]},{"n":33,"t":"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ","p":"585","h":[33]},{"n":34,"t":"يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنْ أَخِيهِ","p":"585","h":[34]},{"n":35,"t":"وَأُمِّهِۦ وَأَبِيهِ","p":"585","h":[35]},{"n":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ","p":"585","h":[36]},{"n":37,"t":"لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ","p":"585","h":[37]},{"n":38,"t":"وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ","p":"585","h":[38]},{"n":39,"t":"ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ","p":"585","h":[39]},{"n":40,"t":"وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ","p":"585","h":[40]},{"n":41,"t":"تَرْهَقُهَا قَتَرَةٌۖ","p":"586","h":[41]},{"n":42,"t":"أُوْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ","p":"586","h":[42]}]}