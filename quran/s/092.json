{"n":92,"name":"الليل","ayat":[{"n":1,"t":"وَاليْلِ إِذَا يَغْشَىٰ","p":"595","h":[1]},{"n":2,"t":"وَالنَّهَارِ إِذَا تَجَلَّىٰ","p":"595","h":[2]},{"n":3,"t":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَالْأُنثَىٰ","p":"595","h":[3]},{"n":4,"t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰۖ","p":"595","h":[4]},{"n":5,"t":"فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ","p":"595","h":[5]},{"n":6,"t":"وَصَدَّقَ بِالْحُسْنَىٰ","p":"595","h":[6]},{"n":7,"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰۖ","p":"595","h":[7]},{"n":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْنَىٰ","p":"595","h":[8]},{"n":9,"t":"وَكَذَّبَ بِالْحُسْنَىٰ","p":"595","h":[9]},{"n":10,"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰۖ","p":"596","h":[10]},{"n":11,"t":"وَمَا يُغْنِے عَنْهُ مَالُهُۥ إِذَا تَرَدَّىٰۖ","p":"596","h":[11]},{"n":12,"t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","p":"596","h":[12]},{"n":13,"t":"وَإِنَّ لَنَا لَلْأٓخِرَةَ وَالْأُولَىٰۖ","p":"596","h":[13]},{"n":14,"t":"فَأَنذَرْتُكُمْ نَاراٗ تَلَظَّىٰ","p":"596","h":[14]},{"n":15,"t":"لَا يَصْلَيٰهَا إِلَّا اَ۬لْأَشْقَى","p":"596","h":[15]},{"n":16,"t":"اَ۬لذِے كَذَّبَ وَتَوَلَّىٰۖ","p":"596","h":[16]},{"n":17,"t":"وَسَيُجَنَّبُهَا اَ۬لْأَتْقَى","p":"596","h":[17]},{"n":18,"t":"اَ۬لذِے يُؤْتِے مَالَهُۥ يَتَزَكَّىٰۖ","p":"596","h":[18]},{"n":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْزَىٰ","p":"596","h":[19]},{"n":20,"t":"إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لْأَعْلَىٰۖ","p":"596","h":[20]},{"n":21,"t":"وَلَسَوْفَ يَرْضَىٰۖ","p":"596","h":[21]}]}