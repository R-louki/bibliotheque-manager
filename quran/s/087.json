{"n":87,"name":"الأعلى","ayat":[{"n":1,"t":"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى","p":"591","h":[1]},{"n":2,"t":"اَ۬لذِے خَلَقَ فَسَوَّىٰ","p":"591","h":[2]},{"n":3,"t":"وَالذِے قَدَّرَ فَهَدَىٰ","p":"591","h":[3]},{"n":4,"t":"وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ","p":"591","h":[4]},{"n":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ","p":"591","h":[5]},{"n":6,"t":"سَنُقْرِئُكَ فَلَا تَنسَىٰ","p":"591","h":[6]},{"n":7,"t":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ","p":"591","h":[7]},{"n":8,"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ","p":"591","h":[8]},{"n":9,"t":"فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ","p":"591","h":[9]},{"n":10,"t":"سَيَذَّكَّرُ مَنْ يَّخْشَىٰ","p":"591","h":[10]},{"n":11,"t":"وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى","p":"592","h":[11]},{"n":12,"t":"اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ","p":"592","h":[12]},{"n":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ","p":"592","h":[13]},{"n":14,"t":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","p":"592","h":[14]},{"n":15,"t":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ","p":"592","h":[15]},{"n":16,"t":"بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا","p":"592","h":[16]},{"n":17,"t":"وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ","p":"592","h":[17]},{"n":18,"t":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ","p":"592","h":[18]},{"n":19,"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ","p":"592","h":[19]}]}