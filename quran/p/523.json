{"p":523,"j":27,"items":[{"k":"v","s":51,"n":52,"t":"كَذَٰلِكَۖ مَا أَتَى اَ۬لذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُواْ سَاحِرٌ أَوْ مَجْنُونٌۖ","a":true,"z":true,"h":[52]},{"k":"v","s":51,"n":53,"t":"أَتَوَاصَوْاْ بِهِۦۖ بَلْ هُمْ قَوْمٞ طَاغُونَۖ","a":true,"z":true,"h":[53]},{"k":"v","s":51,"n":54,"t":"فَتَوَلَّ عَنْهُمْ فَمَا أَنتَ بِمَلُومٖ","a":true,"z":true,"h":[54]},{"k":"v","s":51,"n":55,"t":"وَذَكِّرْۖ فَإِنَّ اَ۬لذِّكْرَىٰ تَنفَعُ اُ۬لْمُؤْمِنِينَۖ","a":true,"z":true,"h":[55]},{"k":"v","s":51,"n":56,"t":"۞ وَمَا خَلَقْتُ اُ۬لْجِنَّ وَالْإِنسَ إِلَّا لِيَعْبُدُونِۖ","a":true,"z":true,"h":[56]},{"k":"v","s":51,"n":57,"t":"مَا أُرِيدُ مِنْهُم مِّن رِّزْقٖ وَمَا أُرِيدُ أَنْ يُّطْعِمُونِۖ","a":true,"z":true,"h":[57]},{"k":"v","s":51,"n":58,"t":"إِنَّ اَ۬للَّهَ هُوَ اَ۬لرَّزَّاقُ ذُو اُ۬لْقُوَّةِ اِ۬لْمَتِينُۖ","a":true,"z":true,"h":[58]},{"k":"v","s":51,"n":59,"t":"فَإِنَّ لِلذِينَ ظَلَمُواْ ذَنُوباٗ مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِۖ","a":true,"z":true,"h":[59]},{"k":"v","s":51,"n":60,"t":"فَوَيْلٞ لِّلذِينَ كَفَرُواْ مِنْ يَّوْمِهِمُ اُ۬لذِے يُوعَدُونَۖ","a":true,"z":true,"h":[60]},{"k":"h","s":52,"name":"الطور"},{"k":"b"},{"k":"v","s":52,"n":1,"t":"وَالطُّورِ وَكِتَٰبٖ مَّسْطُورٖ","a":true,"z":true,"h":[1,2]},{"k":"v","s":52,"n":2,"t":"فِے رَقّٖ مَّنشُورٖ","a":true,"z":true,"h":[3]},{"k":"v","s":52,"n":3,"t":"وَالْبَيْتِ اِ۬لْمَعْمُورِ","a":true,"z":true,"h":[4]},{"k":"v","s":52,"n":4,"t":"وَالسَّقْفِ اِ۬لْمَرْفُوعِ","a":true,"z":true,"h":[5]},{"k":"v","s":52,"n":5,"t":"وَالْبَحْرِ اِ۬لْمَسْجُورِ","a":true,"z":true,"h":[6]},{"k":"v","s":52,"n":6,"t":"إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٞۖ","a":true,"z":true,"h":[7]},{"k":"v","s":52,"n":7,"t":"مَّا لَهُۥ مِن دَافِعٖۖ","a":true,"z":true,"h":[8]},{"k":"v","s":52,"n":8,"t":"يَوْمَ تَمُورُ اُ۬لسَّمَآءُ مَوْراٗ","a":true,"z":true,"h":[9]},{"k":"v","s":52,"n":9,"t":"وَتَسِيرُ اُ۬لْجِبَالُ سَيْراٗۖ","a":true,"z":true,"h":[10]},{"k":"v","s":52,"n":10,"t":"فَوَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ","