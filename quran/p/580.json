{"p":580,"j":29,"items":[{"k":"v","s":76,"n":26,"t":"وَمِنَ اَ۬ليْلِ فَاسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلاٗ طَوِيلاًۖ","a":true,"z":true,"h":[26]},{"k":"v","s":76,"n":27,"t":"إِنَّ هَٰؤُلَآءِ يُحِبُّونَ اَ۬لْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْماٗ ثَقِيلاٗۖ","a":true,"z":true,"h":[27]},{"k":"v","s":76,"n":28,"t":"نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَا أَسْرَهُمْ وَإِذَا شِئْنَا بَدَّلْنَا أَمْثَٰلَهُمْ تَبْدِيلاًۖ","a":true,"z":true,"h":[28]},{"k":"v","s":76,"n":29,"t":"إِنَّ هَٰذِهِۦ تَذْكِرَةٞۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلاٗۖ","a":true,"z":true,"h":[29]},{"k":"v","s":76,"n":30,"t":"وَمَا تَشَآءُونَ إِلَّا أَنْ يَّشَآءَ اَ۬للَّهُۖ إِنَّ اَ۬للَّهَ كَانَ عَلِيماً حَكِيماٗۖ","a":true,"z":true,"h":[30]},{"k":"v","s":76,"n":31,"t":"يُدْخِلُ مَنْ يَّشَآءُ فِے رَحْمَتِهِۦۖ وَالظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَاباً أَلِيماَۢۖ","a":true,"z":true,"h":[31]},{"k":"h","s":77,"name":"المرسلات"},{"k":"b"},{"k":"v","s":77,"n":1,"t":"وَالْمُرْسَلَٰتِ عُرْفاٗ","a":true,"z":true,"h":[1]},{"k":"v","s":77,"n":2,"t":"فَالْعَٰصِفَٰتِ عَصْفاٗ","a":true,"z":true,"h":[2]},{"k":"v","s":77,"n":3,"t":"وَالنَّٰشِرَٰتِ نَشْراٗ","a":true,"z":true,"h":[3]},{"k":"v","s":77,"n":4,"t":"فَالْفَٰرِقَٰتِ فَرْقاٗ","a":true,"z":true,"h":[4]},{"k":"v","s":77,"n":5,"t":"فَالْمُلْقِيَٰتِ ذِكْراً","a":true,"z":true,"h":[5]},{"k":"v","s":77,"n":6,"t":"عُذْراً أَوْ نُذُراً","a":true,"z":true,"h":[6]},{"k":"v","s":77,"n":7,"t":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ","a":true,"z":true,"h":[7]},{"k":"v","s":77,"n":8,"t":"فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ","a":true,"z":true,"h":[8]},{"k":"v","s":77,"n":9,"t":"وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ","a":true,"z":true,"h":[9]},{"k":"v","s":77,"n":10,"t":"وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ","a":true,"z":true,"h":[10]},{"k":"v","s":77,"n":11,"t":"وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ","a":true,"z":true,"h":[11]},{"k":"v","s":77,"n":12,"t":"لِأَيِّ يَوْمٍ أُجِّلَتْ","a":true,"z":true,"h":[12]},{"k":"v","s":77,"n":13,"t":"لِيَوْمِ اِ۬لْفَصْلِۖ","a":true,"z":true,"h":[13]},{"k":"v","s":7