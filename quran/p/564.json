{"p":564,"j":29,"items":[{"k":"v","s":67,"n":28,"t":"فَلَمَّا رَأَوْهُ زُلْفَةٗ س۬يَٓٔتْ وُجُوهُ اُ۬لذِينَ كَفَرُواْ وَقِيلَ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تَدَّعُونَۖ","a":true,"z":true,"h":[27]},{"k":"v","s":67,"n":29,"t":"قُلْ أَرَٰ۬يْتُمْ إِنْ أَهْلَكَنِيَ اَ۬للَّهُ وَمَن مَّعِيَ أَوْ رَحِمَنَا فَمَنْ يُّجِيرُ اُ۬لْكَٰفِرِينَ مِنْ عَذَابٍ أَلِيمٖۖ","a":true,"z":true,"h":[28]},{"k":"v","s":67,"n":30,"t":"قُلْ هُوَ اَ۬لرَّحْمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَاۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِے ضَلَٰلٖ مُّبِينٖۖ","a":true,"z":true,"h":[29]},{"k":"v","s":67,"n":31,"t":"قُلْ أَرَٰ۬يْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْراٗ فَمَنْ يَّأْتِيكُم بِمَآءٖ مَّعِينِۢۖ","a":true,"z":true,"h":[30]},{"k":"h","s":68,"name":"القلم"},{"k":"b"},{"k":"v","s":68,"n":1,"t":"نُٓۖ وَالْقَلَمِ وَمَا يَسْطُرُونَ","a":true,"z":true,"h":[1]},{"k":"v","s":68,"n":2,"t":"مَا أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٖ","a":true,"z":true,"h":[2]},{"k":"v","s":68,"n":3,"t":"وَإِنَّ لَكَ لَأَجْراً غَيْرَ مَمْنُونٖ","a":true,"z":true,"h":[3]},{"k":"v","s":68,"n":4,"t":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖۖ","a":true,"z":true,"h":[4]},{"k":"v","s":68,"n":5,"t":"فَسَتُبْصِرُ وَيُبْصِرُونَ","a":true,"z":true,"h":[5]},{"k":"v","s":68,"n":6,"t":"بِأَييِّكُمُ اُ۬لْمَفْتُونُۖ","a":true,"z":true,"h":[6]},{"k":"v","s":68,"n":7,"t":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهْوَ أَعْلَمُ بِالْمُهْتَدِينَۖ","a":true,"z":true,"h":[7]},{"k":"v","s":68,"n":8,"t":"فَلَا تُطِعِ اِ۬لْمُكَذِّبِينَۖ","a":true,"z":true,"h":[8]},{"k":"v","s":68,"n":9,"t":"وَدُّواْ لَوْ تُدْهِنُ فَيُدْهِنُونَۖ","a":true,"z":true,"h":[9]},{"k":"v","s":68,"n":10,"t":"وَلَا تُطِعْ كُلَّ حَلَّٰفٖ مَّهِينٍ","a":true,"z":true,"h":[10]},{"k":"v","s":68,"n":11,"t":"هَمَّازٖ مَّشَّآءِۢ بِنَمِيمٖ","a":true,"z":true,"h":[11]},{"k":"v","s":68,"n":12,"t":"مَّنَّاعٖ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","a":true,"z":true,"h":[12]},{"k":"v","s":68,"n":13,"t":"عُتُلِّۢ بَعْدَ ذَٰلِكَ زَنِيمٍ","a":true,"z":true,"h":[13]},{"k":"v","s":68,"n":14,"t":"أَن