{"p":498,"j":25,"items":[{"k":"v","s":44,"n":38,"t":"إِنَّ يَوْمَ اَ۬لْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ","a":true,"z":true,"h":[40]},{"k":"v","s":44,"n":39,"t":"يَوْمَ لَا يُغْنِے مَوْلىً عَن مَّوْلىٗ شَئْاٗ وَلَا هُمْ يُنصَرُونَ","a":true,"z":true,"h":[41]},{"k":"v","s":44,"n":40,"t":"إِلَّا مَن رَّحِمَ اَ۬للَّهُۖ إِنَّهُۥ هُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[42]},{"k":"v","s":44,"n":41,"t":"إِنَّ شَجَرَتَ اَ۬لزَّقُّومِ طَعَامُ اُ۬لْأَثِيمِ","a":true,"z":true,"h":[43,44]},{"k":"v","s":44,"n":42,"t":"كَالْمُهْلِ تَغْلِے فِے اِ۬لْبُطُونِ","a":true,"z":true,"h":[45]},{"k":"v","s":44,"n":43,"t":"كَغَلْيِ اِ۬لْحَمِيمِۖ","a":true,"z":true,"h":[46]},{"k":"v","s":44,"n":44,"t":"خُذُوهُ فَاعْتُلُوهُ إِلَىٰ سَوَآءِ اِ۬لْجَحِيمِ","a":true,"z":true,"h":[47]},{"k":"v","s":44,"n":45,"t":"ثُمَّ صُبُّواْ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ اِ۬لْحَمِيمِ","a":true,"z":true,"h":[48]},{"k":"v","s":44,"n":46,"t":"ذُقْۖ إِنَّكَ أَنتَ اَ۬لْعَزِيزُ اُ۬لْكَرِيمُۖ","a":true,"z":true,"h":[49]},{"k":"v","s":44,"n":47,"t":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَۖ","a":true,"z":true,"h":[50]},{"k":"v","s":44,"n":48,"t":"إِنَّ اَ۬لْمُتَّقِينَ فِے مُقَامٍ أَمِينٖ","a":true,"z":true,"h":[51]},{"k":"v","s":44,"n":49,"t":"فِے جَنَّٰتٖ وَعُيُونٖ","a":true,"z":true,"h":[52]},{"k":"v","s":44,"n":50,"t":"يَلْبَسُونَ مِن سُندُسٖ وَإِسْتَبْرَقٖ مُّتَقَٰبِلِينَۖ","a":true,"z":true,"h":[53]},{"k":"v","s":44,"n":51,"t":"كَذَٰلِكَۖ وَزَوَّجْنَٰهُم بِحُورٍ عِينٖۖ","a":true,"z":true,"h":[54]},{"k":"v","s":44,"n":52,"t":"يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَۖ","a":true,"z":true,"h":[55]},{"k":"v","s":44,"n":53,"t":"لَا يَذُوقُونَ فِيهَا اَ۬لْمَوْتَۖ إِلَّا اَ۬لْمَوْتَةَ اَ۬لْأُولَىٰۖ وَوَقَيٰهُمْ عَذَابَ اَ۬لْجَحِيمِ","a":true,"z":true,"h":[56]},{"k":"v","s":44,"n":54,"t":"فَضْلاٗ مِّن رَّبِّكَۖ ذَٰلِكَ هُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ","a":true,"z":true,"h":[57]},{"k":"v","s":44,"n":55,"t":"فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَۖ","a":true,"z":true,"h":[58]},{"k":"v","s":44,"n":56,"t":"فَارْتَقِبْۖ إِنَّهُم مُّرْتَقِبُونَۖ","a":true,"z":true,"h":[59]}]}