{"p":376,"j":19,"items":[{"k":"v","s":26,"n":207,"t":"مَا أَغْنَىٰ عَنْهُم مَّا كَانُواْ يُمَتَّعُونَۖ","a":true,"z":true,"h":[207]},{"k":"v","s":26,"n":208,"t":"وَمَا أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ","a":true,"z":true,"h":[208]},{"k":"v","s":26,"n":209,"t":"ذِكْرَىٰۖ وَمَا كُنَّا ظَٰلِمِينَۖ","a":true,"z":true,"h":[209]},{"k":"v","s":26,"n":210,"t":"۞ وَمَا تَنَزَّلَتْ بِهِ اِ۬لشَّيَٰطِينُ وَمَا يَنۢبَغِے لَهُمْ وَمَا يَسْتَطِيعُونَۖ","a":true,"z":true,"h":[210,211]},{"k":"v","s":26,"n":211,"t":"إِنَّهُمْ عَنِ اِ۬لسَّمْعِ لَمَعْزُولُونَۖ","a":true,"z":true,"h":[212]},{"k":"v","s":26,"n":212,"t":"فَلَا تَدْعُ مَعَ اَ۬للَّهِ إِلَٰهاً ءَاخَرَ فَتَكُونَ مِنَ اَ۬لْمُعَذَّبِينَۖ","a":true,"z":true,"h":[213]},{"k":"v","s":26,"n":213,"t":"وَأَنذِرْ عَشِيرَتَكَ اَ۬لْأَقْرَبِينَ","a":true,"z":true,"h":[214]},{"k":"v","s":26,"n":214,"t":"وَاخْفِضْ جَنَاحَكَ لِمَنِ اِ۪تَّبَعَكَ مِنَ اَ۬لْمُؤْمِنِينَۖ","a":true,"z":true,"h":[215]},{"k":"v","s":26,"n":215,"t":"فَإِنْ عَصَوْكَ فَقُلْ إِنِّے بَرِےٓءٞ مِّمَّا تَعْمَلُونَۖ","a":true,"z":true,"h":[216]},{"k":"v","s":26,"n":216,"t":"فَتَوَكَّلْ عَلَى اَ۬لْعَزِيزِ اِ۬لرَّحِيمِ","a":true,"z":true,"h":[217]},{"k":"v","s":26,"n":217,"t":"اِ۬لذِے يَرَيٰكَ حِينَ تَقُومُ","a":true,"z":true,"h":[218]},{"k":"v","s":26,"n":218,"t":"وَتَقَلُّبَكَ فِے اِ۬لسَّٰجِدِينَۖ","a":true,"z":true,"h":[219]},{"k":"v","s":26,"n":219,"t":"إِنَّهُۥ هُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ","a":true,"z":true,"h":[220]},{"k":"v","s":26,"n":220,"t":"هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ اُ۬لشَّيَٰطِينُ","a":true,"z":true,"h":[221]},{"k":"v","s":26,"n":221,"t":"تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٖ","a":true,"z":true,"h":[222]},{"k":"v","s":26,"n":222,"t":"يُلْقُونَ اَ۬لسَّمْعَ وَأَكْثَرُهُمْ كَٰذِبُونَۖ","a":true,"z":true,"h":[223]},{"k":"v","s":26,"n":223,"t":"وَالشُّعَرَآءُ يَتْبَعُهُمُ اُ۬لْغَاوُۥنَۖ","a":true,"z":true,"h":[224]},{"k":"v","s":26,"n":224,"t":"أَلَمْ تَرَ أَنَّهُمْ فِے كُلِّ وَادٖ يَهِيمُونَ","a":true,"z":true,"h":[225]},{"k":"v","s":26,"n":225,"t":"وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَۖ","a":true,"z":true,"h":[226]},{"k":"v","s":26,"n":226,"t":"إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَذَكَرُواْ اُ۬للَّهَ كَثِيراٗ وَانتَصَرُواْ مِنۢ بَعْدِ مَا ظُلِمُواْۖ وَسَيَعْلَمُ اُ۬لذِينَ ظَلَمُواْ أَيَّ مُنقَلَبٖ يَنقَلِبُونَۖ","a":true,"z":true,"h":[227]}]}