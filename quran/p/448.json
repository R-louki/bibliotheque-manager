{"p":448,"j":23,"items":[{"k":"v","s":37,"n":52,"t":"يَقُولُ أَٰ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ","a":true,"z":true,"h":[52]},{"k":"v","s":37,"n":53,"t":"أَٰ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَدِينُونَۖ","a":true,"z":true,"h":[53]},{"k":"v","s":37,"n":54,"t":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","a":true,"z":true,"h":[54]},{"k":"v","s":37,"n":55,"t":"فَاطَّلَعَ فَرَءَاهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ","a":true,"z":true,"h":[55]},{"k":"v","s":37,"n":56,"t":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ","a":true,"z":true,"h":[56]},{"k":"v","s":37,"n":57,"t":"وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ","a":true,"z":true,"h":[57]},{"k":"v","s":37,"n":58,"t":"أَفَمَا نَحْنُ بِمَيِّتِينَ","a":true,"z":true,"h":[58]},{"k":"v","s":37,"n":59,"t":"إِلَّا مَوْتَتَنَا اَ۬لْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ","a":true,"z":true,"h":[59]},{"k":"v","s":37,"n":60,"t":"إِنَّ هَٰذَا لَهْوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ","a":true,"z":true,"h":[60]},{"k":"v","s":37,"n":61,"t":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ","a":true,"z":true,"h":[61]},{"k":"v","s":37,"n":62,"t":"أَذَٰلِكَ خَيْرٞ نُّزُلاً أَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ","a":true,"z":true,"h":[62]},{"k":"v","s":37,"n":63,"t":"إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ","a":true,"z":true,"h":[63]},{"k":"v","s":37,"n":64,"t":"إِنَّهَا شَجَرَةٞ تَخْرُجُ فِے أَصْلِ اِ۬لْجَحِيمِ","a":true,"z":true,"h":[64]},{"k":"v","s":37,"n":65,"t":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ","a":true,"z":true,"h":[65]},{"k":"v","s":37,"n":66,"t":"فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ","a":true,"z":true,"h":[66]},{"k":"v","s":37,"n":67,"t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ","a":true,"z":true,"h":[67]},{"k":"v","s":37,"n":68,"t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى اَ۬لْجَحِيمِۖ","a":true,"z":true,"h":[68]},{"k":"v","s":37,"n":69,"t":"إِنَّهُمْ أَلْفَوْاْ ءَابَآءَهُمْ ضَآلِّينَ","a":true,"z":true,"h":[69]},{"k":"v","s":37,"n":70,"t":"فَهُمْ عَلَىٰ ءَاثَٰرِهِمْ يُهْرَعُونَۖ","a":true,"z":true,"h":[70]},{"k":"v","s":37,"n":71,"t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ اُ۬لْأَوَّلِينَۖ","a":true,"z":true,"h":[71]},{"k":"v","s":37,"n":72,"t":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَۖ","a":true,"z":true,"h":[72]},{"k":"v","s":37,"n":73,"t":"فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ","a":true,"z":true,"h":[73]},{"k":"v","s":37,"n":74,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ","a":true,"z":true,"h":[74]},{"k":"v","s":37,"n":75,"t":"وَلَقَدْ نَادَيٰنَا نُوحٞۖ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ","a":true,"z":true,"h":[75]},{"k":"v","s":37,"n":76,"t":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ","a":true,"z":true,"h":[76]}]}