{"p":370,"j":19,"items":[{"k":"v","s":26,"n":61,"t":"فَلَمَّا تَرَٰٓءَا اَ۬لْجَمْعَٰنِ قَالَ أَصْحَٰبُ مُوسَىٰ إِنَّا لَمُدْرَكُونَۖ","a":true,"z":true,"h":[61]},{"k":"v","s":26,"n":62,"t":"قَالَ كَلَّاۖ إِنَّ مَعِے رَبِّے سَيَهْدِينِۖ","a":true,"z":true,"h":[62]},{"k":"v","s":26,"n":63,"t":"فَأَوْحَيْنَا إِلَىٰ مُوسَىٰ أَنِ اِ۪ضْرِب بِّعَصَاكَ اَ۬لْبَحْرَ فَانفَلَقَ فَكَانَ كُلُّ فِرْقٖ كَالطَّوْدِ اِ۬لْعَظِيمِۖ","a":true,"z":true,"h":[63]},{"k":"v","s":26,"n":64,"t":"وَأَزْلَفْنَا ثَمَّ اَ۬لْأٓخَرِينَۖ","a":true,"z":true,"h":[64]},{"k":"v","s":26,"n":65,"t":"وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥ أَجْمَعِينَ","a":true,"z":true,"h":[65]},{"k":"v","s":26,"n":66,"t":"ثُمَّ أَغْرَقْنَا اَ۬لْأٓخَرِينَۖ","a":true,"z":true,"h":[66]},{"k":"v","s":26,"n":67,"t":"إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ","a":true,"z":true,"h":[67]},{"k":"v","s":26,"n":68,"t":"وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[68]},{"k":"v","s":26,"n":69,"t":"وَاتْلُ عَلَيْهِمْ نَبَأَ ا۪بْرَٰهِيمَ","a":true,"z":true,"h":[69]},{"k":"v","s":26,"n":70,"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَۖ","a":true,"z":true,"h":[70]},{"k":"v","s":26,"n":71,"t":"قَالُواْ نَعْبُدُ أَصْنَاماٗ فَنَظَلُّ لَهَا عَٰكِفِينَۖ","a":true,"z":true,"h":[71]},{"k":"v","s":26,"n":72,"t":"قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ","a":true,"z":true,"h":[72]},{"k":"v","s":26,"n":73,"t":"أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَۖ","a":true,"z":true,"h":[73]},{"k":"v","s":26,"n":74,"t":"قَالُواْ بَلْ وَجَدْنَا ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَۖ","a":true,"z":true,"h":[74]},{"k":"v","s":26,"n":75,"t":"قَالَ أَفَرَٰ۬يْتُم مَّا كُنتُمْ تَعْبُدُونَ","a":true,"z":true,"h":[75]},{"k":"v","s":26,"n":76,"t":"أَنتُمْ وَءَابَآؤُكُمُ اُ۬لْأَقْدَمُونَ","a":true,"z":true,"h":[76]},{"k":"v","s":26,"n":77,"t":"فَإِنَّهُمْ عَدُوّٞ لِّيَۖ إِلَّا رَبَّ اَ۬لْعَٰلَمِينَ","a":true,"z":true,"h":[77]},{"k":"v","s":26,"n":78,"t":"اَ۬لذِے خَلَقَنِے فَهْوَ يَهْدِينِۖ","a":true,"z":true,"h":[78]},{"k":"v","s":26,"n":79,"t":"وَالذِے هُوَ يُطْعِمُنِے وَيَسْقِينِ","a":true,"z":true,"h":[79]},{"k":"v","s":26,"n":80,"t":"وَإِذَا مَرِضْتُ فَهْوَ يَشْفِينِۖ","a":true,"z":true,"h":[80]},{"k":"v","s":26,"n":81,"t":"وَالذِے يُمِيتُنِے ثُمَّ يُحْيِينِۖ","a":true,"z":true,"h":[81]},{"k":"v","s":26,"n":82,"t":"۞ وَالذِے أَطْمَعُ أَنْ يَّغْفِرَ لِے خَطِيَٓٔتِے يَوْمَ اَ۬لدِّينِۖ","a":true,"z":true,"h":[82]},{"k":"v","s":26,"n":83,"t":"رَبِّ هَبْ لِے حُكْماٗ وَأَلْحِقْنِے بِالصَّٰلِحِينَۖ","a":true,"z":true,"h":[83]}]}