فَإِذَا هُمْ يَنظُرُونَۖ","a":true,"z":true,"h":[19]},{"k":"v","s":37,"n":20,"t":"وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ","a":true,"z":true,"h":[20]},{"k":"v","s":37,"n":21,"t":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ","a":true,"z":true,"h":[21]},{"k":"v","s":37,"n":22,"t":"۞ اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ","a":true,"z":true,"h":[22]},{"k":"v","s":37,"n":23,"t":"مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمْ إِلَىٰ صِرَٰطِ اِ۬لْجَحِيمِۖ","a":true,"z":true,"h":[23]},{"k":"v","s":37,"n":24,"t":"وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَۖ","a":true,"z":true,"h":[24]}]}