{"p":266,"j":14,"items":[{"k":"v","s":15,"n":71,"t":"قَالَ هَٰؤُلَآءِ بَنَاتِيَ إِن كُنتُمْ فَٰعِلِينَۖ","a":true,"z":true,"h":[71]},{"k":"v","s":15,"n":72,"t":"لَعَمْرُكَ إِنَّهُمْ لَفِے سَكْرَتِهِمْ يَعْمَهُونَۖ","a":true,"z":true,"h":[72]},{"k":"v","s":15,"n":73,"t":"فَأَخَذَتْهُمُ اُ۬لصَّيْحَةُ مُشْرِقِينَ","a":true,"z":true,"h":[73]},{"k":"v","s":15,"n":74,"t":"فَجَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةٗ مِّن سِجِّيلٍۖ","a":true,"z":true,"h":[74]},{"k":"v","s":15,"n":75,"t":"إِنَّ فِے ذَٰلِكَ لَأٓيَٰتٖ لِّلْمُتَوَسِّمِينَۖ","a":true,"z":true,"h":[75]},{"k":"v","s":15,"n":76,"t":"وَإِنَّهَا لَبِسَبِيلٖ مُّقِيمٍۖ","a":true,"z":true,"h":[76]},{"k":"v","s":15,"n":77,"t":"إِنَّ فِے ذَٰلِكَ لَأٓيَةٗ لِّلْمُؤْمِنِينَۖ","a":true,"z":true,"h":[77]},{"k":"v","s":15,"n":78,"t":"۞ وَإِن كَانَ أَصْحَٰبُ اُ۬لْأَيْكَةِ لَظَٰلِمِينَۖ","a":true,"z":true,"h":[78]},{"k":"v","s":15,"n":79,"t":"فَانتَقَمْنَا مِنْهُمْۖ وَإِنَّهُمَا لَبِإِمَامٖ مُّبِينٖۖ","a":true,"z":true,"h":[79]},{"k":"v","s":15,"n":80,"t":"وَلَقَدْ كَذَّبَ أَصْحَٰبُ اُ۬لْحِجْرِ اِ۬لْمُرْسَلِينَۖ","a":true,"z":true,"h":[80]},{"k":"v","s":15,"n":81,"t":"وَءَاتَيْنَٰهُمْ ءَايَٰتِنَا فَكَانُواْ عَنْهَا مُعْرِضِينَۖ","a":true,"z":true,"h":[81]},{"k":"v","s":15,"n":82,"t":"وَكَانُواْ يَنْحِتُونَ مِنَ اَ۬لْجِبَالِ بِيُوتاً ءَامِنِينَۖ","a":true,"z":true,"h":[82]},{"k":"v","s":15,"n":83,"t":"فَأَخَذَتْهُمُ اُ۬لصَّيْحَةُ مُصْبِحِينَۖ","a":true,"z":true,"h":[83]},{"k":"v","s":15,"n":84,"t":"فَمَا أَغْنَىٰ عَنْهُم مَّا كَانُواْ يَكْسِبُونَۖ","a":true,"z":true,"h":[84]},{"k":"v","s":15,"n":85,"t":"وَمَا خَلَقْنَا اَ۬لسَّمَٰوَٰتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا إِلَّا بِالْحَقِّۖ وَإِنَّ اَ۬لسَّاعَةَ لَأٓتِيَةٞۖ فَاصْفَحِ اِ۬لصَّفْحَ اَ۬لْجَمِيلَۖ","a":true,"z":true,"h":[85]},{"k":"v","s":15,"n":86,"t":"إِنَّ رَبَّكَ هُوَ اَ۬لْخَلَّٰقُ اُ۬لْعَلِيمُۖ","a":true,"z":true,"h":[86]},{"k":"v","s":15,"n":87,"t":"وَلَقَدْ ءَاتَيْنَٰكَ سَبْعاٗ مِّنَ اَ۬لْمَثَانِے وَالْقُرْءَانَ اَ۬لْعَظِيمَۖ","a":true,"z":true,"h":[87]},{"k":"v","s":15,"n":88,"t":"لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦ أَزْوَٰجاٗ مِّنْهُمْۖ وَلَا تَحْزَنْ عَلَيْهِمْۖ وَاخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَۖ","a":true,"z":true,"h":[88]},{"k":"v","s":15,"n":89,"t":"وَقُلْ إِنِّيَ أَنَا اَ۬لنَّذِيرُ اُ۬لْمُبِينُ","a":true,"z":true,"h":[89]},{"k":"v","s":15,"n":90,"t":"كَمَا أَنزَلْنَا عَلَى اَ۬لْمُقْتَسِمِينَ","a":true,"z":true,"h":[90]}]}