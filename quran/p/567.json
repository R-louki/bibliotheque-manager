{"p":567,"j":29,"items":[{"k":"v","s":69,"n":8,"t":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُؤْتَفِكَٰتُ بِالْخَاطِئَةِ","a":true,"z":true,"h":[9]},{"k":"v","s":69,"n":9,"t":"فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةٗ رَّابِيَةًۖ","a":true,"z":true,"h":[10]},{"k":"v","s":69,"n":10,"t":"إِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ","a":true,"z":true,"h":[11]},{"k":"v","s":69,"n":11,"t":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَا أُذْنٞ وَٰعِيَةٞۖ","a":true,"z":true,"h":[12]},{"k":"v","s":69,"n":12,"t":"فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ","a":true,"z":true,"h":[13]},{"k":"v","s":69,"n":13,"t":"وَحُمِلَتِ اِ۬لْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ","a":true,"z":true,"h":[14]},{"k":"v","s":69,"n":14,"t":"فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ","a":true,"z":true,"h":[15]},{"k":"v","s":69,"n":15,"t":"وَانشَقَّتِ اِ۬لسَّمَآءُ فَهْيَ يَوْمَئِذٖ وَاهِيَةٞ","a":true,"z":true,"h":[16]},{"k":"v","s":69,"n":16,"t":"وَالْمَلَكُ عَلَىٰ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ","a":true,"z":true,"h":[17]},{"k":"v","s":69,"n":17,"t":"يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٞۖ","a":true,"z":true,"h":[18]},{"k":"v","s":69,"n":18,"t":"۞ فَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ","a":true,"z":true,"h":[19]},{"k":"v","s":69,"n":19,"t":"إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ","a":true,"z":true,"h":[20]},{"k":"v","s":69,"n":20,"t":"فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖ","a":true,"z":true,"h":[21]},{"k":"v","s":69,"n":21,"t":"فِے جَنَّةٍ عَالِيَةٖ","a":true,"z":true,"h":[22]},{"k":"v","s":69,"n":22,"t":"قُطُوفُهَا دَانِيَةٞۖ","a":true,"z":true,"h":[23]},{"k":"v","s":69,"n":23,"t":"كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا أَسْلَفْتُمْ فِے اِ۬لْأَيَّامِ اِ۬لْخَالِيَةِۖ","a":true,"z":true,"h":[24]},{"k":"v","s":69,"n":24,"t":"وَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ","a":true,"z":true,"h":[25]},{"k":"v","s":69,"n":25,"t":"فَيَقُولُ يَٰلَيْتَنِے لَمْ أُوتَ كِتَٰبِيَهْۖ","a":true,"z":true,"h":[25]},{"k":"v","s":69,"n":26,"t":"وَلَمْ أَدْرِ مَا حِسَابِيَهْۖ","a":true,"z":true,"h":[26]},{"k":"v","s":69,"n":27,"t":"يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ","a":true,"z":true,"h":[27]},{"k":"v","s":69,"n":28,"t":"مَا أَغْنَىٰ عَنِّے مَالِيَهۖ","a":true,"z":true,"h":[28]},{"k":"v","s":69,"n":29,"t":"هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ","a":true,"z":true,"h":[29]},{"k":"v","s":69,"n":30,"t":"خُذُوهُ فَغُلُّوهُ","a":true,"z":true,"h":[30]},{"k":"v","s":69,"n":31,"t":"ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ","a":true,"z":true,"h":[31]},{"k":"v","s":69,"n":32,"t":"ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ","a":true,"z":true,"h":[32]},{"k":"v","s":69,"n":33,"t":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِاللَّهِ اِ۬لْعَظِيمِ","a":true,"z":true,"h":[33]},{"k":"v","s":69,"n":34,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ","a":true,"z":true,"h":[34]},{"k":"v","s":69,"n":35,"t":"فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ","a":true,"z":true,"h":[35]}]}