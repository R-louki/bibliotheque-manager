{"p":313,"j":16,"items":[{"k":"v","s":20,"n":12,"t":"وَأَنَا اَ۪خْتَرْتُكَ فَاسْتَمِعْ لِمَا يُوحَىٰ","a":true,"z":true,"h":[13]},{"k":"v","s":20,"n":13,"t":"إِنَّنِيَ أَنَا اَ۬للَّهُ لَا إِلَٰهَ إِلَّا أَنَا فَاعْبُدْنِے وَأَقِمِ اِ۬لصَّلَوٰةَ لِذِكْرِيَۖ","a":true,"z":true,"h":[14]},{"k":"v","s":20,"n":14,"t":"إِنَّ اَ۬لسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسِۢ بِمَا تَسْعَىٰۖ","a":true,"z":true,"h":[15]},{"k":"v","s":20,"n":15,"t":"فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَاتَّبَعَ هَوَيٰهُ فَتَرْدَىٰۖ","a":true,"z":true,"h":[16]},{"k":"v","s":20,"n":16,"t":"وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰۖ","a":true,"z":true,"h":[17]},{"k":"v","s":20,"n":17,"t":"قَالَ هِيَ عَصَايَ أَتَوَكَّؤُاْ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِے وَلِے فِيهَا مَـَٔارِبُ أُخْرَىٰۖ","a":true,"z":true,"h":[18]},{"k":"v","s":20,"n":18,"t":"قَالَ أَلْقِهَا يَٰمُوسَىٰۖ","a":true,"z":true,"h":[19]},{"k":"v","s":20,"n":19,"t":"فَأَلْقَيٰهَا فَإِذَا هِيَ حَيَّةٞ تَسْعَىٰۖ","a":true,"z":true,"h":[20]},{"k":"v","s":20,"n":20,"t":"قَالَ خُذْهَا وَلَا تَخَفْ سَنُعِيدُهَا سِيرَتَهَا اَ۬لْأُولَىٰۖ","a":true,"z":true,"h":[21]},{"k":"v","s":20,"n":21,"t":"وَاضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ","a":true,"z":true,"h":[22]},{"k":"v","s":20,"n":22,"t":"لِنُرِيَكَ مِنْ ءَايَٰتِنَا اَ۬لْكُبْرَىۖ","a":true,"z":true,"h":[23]},{"k":"v","s":20,"n":23,"t":"اَ۪ذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰۖ","a":true,"z":true,"h":[24]},{"k":"v","s":20,"n":24,"t":"قَالَ رَبِّ اِ۪شْرَحْ لِے صَدْرِے","a":true,"z":true,"h":[25]},{"k":"v","s":20,"n":25,"t":"وَيَسِّرْ لِيَ أَمْرِے","a":true,"z":true,"h":[26]},{"k":"v","s":20,"n":26,"t":"وَاحْلُلْ عُقْدَةٗ مِّن لِّسَانِے","a":true,"z":true,"h":[27]},{"k":"v","s":20,"n":27,"t":"يَفْقَهُواْ قَوْلِے","a":true,"z":true,"h":[28]},{"k":"v","s":20,"n":28,"t":"وَاجْعَل لِّے وَزِيراٗ مِّنْ أَهْلِے","a":true,"z":true,"h":[29]},{"k":"v","s":20,"n":29,"t":"هَٰرُونَ أَخِےۖ","a":true,"z":true,"h":[30]},{"k":"v","s":20,"n":30,"t":"اِ۟شْدُدْ بِهِۦ أَزْرِے","a":true,"z":true,"h":[31]},{"k":"v","s":20,"n":31,"t":"وَأَشْرِكْهُ فِے أَمْرِے","a":true,"z":true,"h":[32]},{"k":"v","s":20,"n":32,"t":"كَےْ نُسَبِّحَكَ كَثِيراٗ","a":true,"z":true,"h":[33]},{"k":"v","s":20,"n":33,"t":"وَنَذْكُرَكَ كَثِيراً","a":true,"z":true,"h":[34]},{"k":"v","s":20,"n":34,"t":"إِنَّكَ كُنتَ بِنَا بَصِيراٗۖ","a":true,"z":true,"h":[35]},{"k":"v","s":20,"n":35,"t":"۞ قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰۖ","a":true,"z":true,"h":[36]},{"k":"v","s":20,"n":36,"t":"وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰ","a":true,"z":true,"h":[37]}]}