{"p":531,"j":27,"items":[{"k":"v","s":54,"n":50,"t":"وَمَا أَمْرُنَا إِلَّا وَٰحِدَةٞ كَلَمْحِۢ بِالْبَصَرِۖ","a":true,"z":true,"h":[50]},{"k":"v","s":54,"n":51,"t":"وَلَقَدْ أَهْلَكْنَا أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٖۖ","a":true,"z":true,"h":[51]},{"k":"v","s":54,"n":52,"t":"وَكُلُّ شَےْءٖ فَعَلُوهُ فِے اِ۬لزُّبُرِۖ","a":true,"z":true,"h":[52]},{"k":"v","s":54,"n":53,"t":"وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسْتَطَرٌۖ","a":true,"z":true,"h":[53]},{"k":"v","s":54,"n":54,"t":"إِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتٖ وَنَهَرٖ","a":true,"z":true,"h":[54]},{"k":"v","s":54,"n":55,"t":"فِے مَقْعَدِ صِدْقٍ عِندَ مَلِيكٖ مُّقْتَدِرِۢۖ","a":true,"z":true,"h":[55]},{"k":"h","s":55,"name":"الرحمن"},{"k":"b"},{"k":"v","s":55,"n":1,"t":"اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ","a":true,"z":true,"h":[1,2]},{"k":"v","s":55,"n":2,"t":"خَلَقَ اَ۬لْإِنسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ","a":true,"z":true,"h":[3,4]},{"k":"v","s":55,"n":3,"t":"اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ","a":true,"z":true,"h":[5]},{"k":"v","s":55,"n":4,"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ","a":true,"z":true,"h":[6]},{"k":"v","s":55,"n":5,"t":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ","a":true,"z":true,"h":[7]},{"k":"v","s":55,"n":6,"t":"أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ","a":true,"z":true,"h":[8]},{"k":"v","s":55,"n":7,"t":"وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ","a":true,"z":true,"h":[9]},{"k":"v","s":55,"n":8,"t":"وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ","a":true,"z":true,"h":[10]},{"k":"v","s":55,"n":9,"t":"فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لْأَكْمَامِ","a":true,"z":true,"h":[11]},{"k":"v","s":55,"n":10,"t":"وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ","a":true,"z":true,"h":[12]},{"k":"v","s":55,"n":11,"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ","a":true,"z":true,"h":[13]},{"k":"v","s":55,"n":12,"t":"خَلَقَ اَ۬لْإِنسَٰنَ مِن صَلْصَٰلٖ كَالْفَخَّارِ","a":true,"z":true,"h":[14]},{"k":"v","s":55,"n":13,"t":"وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نَّارٖۖ","a":true,"z":true,"h":