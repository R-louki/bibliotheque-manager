{"p":569,"j":29,"items":[{"k":"v","s":70,"n":11,"t":"يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ","a":true,"z":true,"h":[11]},{"k":"v","s":70,"n":12,"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","a":true,"z":true,"h":[12]},{"k":"v","s":70,"n":13,"t":"وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ","a":true,"z":true,"h":[13]},{"k":"v","s":70,"n":14,"t":"وَمَن فِے اِ۬لْأَرْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ","a":true,"z":true,"h":[14]},{"k":"v","s":70,"n":15,"t":"كَلَّاۖ إِنَّهَا لَظَىٰ","a":true,"z":true,"h":[15]},{"k":"v","s":70,"n":16,"t":"نَزَّاعَةٞ لِّلشَّوَىٰ","a":true,"z":true,"h":[16]},{"k":"v","s":70,"n":17,"t":"تَدْعُواْ مَنْ أَدْبَرَ وَتَوَلَّىٰ","a":true,"z":true,"h":[17]},{"k":"v","s":70,"n":18,"t":"وَجَمَعَ فَأَوْعَىٰۖ","a":true,"z":true,"h":[18]},{"k":"v","s":70,"n":19,"t":"۞ إِنَّ اَ۬لْإِنسَٰنَ خُلِقَ هَلُوعاً","a":true,"z":true,"h":[19]},{"k":"v","s":70,"n":20,"t":"إِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ","a":true,"z":true,"h":[20]},{"k":"v","s":70,"n":21,"t":"وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً","a":true,"z":true,"h":[21]},{"k":"v","s":70,"n":22,"t":"إِلَّا اَ۬لْمُصَلِّينَ","a":true,"z":true,"h":[22]},{"k":"v","s":70,"n":23,"t":"اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ","a":true,"z":true,"h":[23]},{"k":"v","s":70,"n":24,"t":"وَالذِينَ فِے أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ","a":true,"z":true,"h":[24]},{"k":"v","s":70,"n":25,"t":"لِّلسَّآئِلِ وَالْمَحْرُومِۖ","a":true,"z":true,"h":[25]},{"k":"v","s":70,"n":26,"t":"وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ","a":true,"z":true,"h":[26]},{"k":"v","s":70,"n":27,"t":"وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","a":true,"z":true,"h":[27]},{"k":"v","s":70,"n":28,"t":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٖۖ","a":true,"z":true,"h":[28]},{"k":"v","s":70,"n":29,"t":"وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","a":true,"z":true,"h":[29]},{"k":"v","s":70,"n":30,"t":"إِلَّا عَلَىٰ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ","a":true,"z":true,"h":[30]},{"k":"v","s":70,