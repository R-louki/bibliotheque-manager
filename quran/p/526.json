{"p":526,"j":27,"items":[{"k":"h","s":53,"name":"النجم"},{"k":"b"},{"k":"v","s":53,"n":1,"t":"وَالنَّجْمِ إِذَا هَوَىٰ","a":true,"z":true,"h":[1]},{"k":"v","s":53,"n":2,"t":"مَا ضَلَّ صَٰحِبُكُمْ وَمَا غَوَىٰ","a":true,"z":true,"h":[2]},{"k":"v","s":53,"n":3,"t":"وَمَا يَنطِقُ عَنِ اِ۬لْهَوَىٰ","a":true,"z":true,"h":[3]},{"k":"v","s":53,"n":4,"t":"إِنْ هُوَ إِلَّا وَحْيٞ يُوحَىٰۖ","a":true,"z":true,"h":[4]},{"k":"v","s":53,"n":5,"t":"عَلَّمَهُۥ شَدِيدُ اُ۬لْقُوَىٰ","a":true,"z":true,"h":[5]},{"k":"v","s":53,"n":6,"t":"ذُو مِرَّةٖۖ فَاسْتَوَىٰ","a":true,"z":true,"h":[6]},{"k":"v","s":53,"n":7,"t":"وَهْوَ بِالْأُفُقِ اِ۬لْأَعْلَىٰۖ","a":true,"z":true,"h":[7]},{"k":"v","s":53,"n":8,"t":"ثُمَّ دَنَا فَتَدَلَّىٰ","a":true,"z":true,"h":[8]},{"k":"v","s":53,"n":9,"t":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰۖ","a":true,"z":true,"h":[9]},{"k":"v","s":53,"n":10,"t":"فَأَوْحَىٰ إِلَىٰ عَبْدِهِۦ مَا أَوْحَىٰۖ","a":true,"z":true,"h":[10]},{"k":"v","s":53,"n":11,"t":"مَا كَذَبَ اَ۬لْفُؤَادُ مَا رَأَىٰۖ","a":true,"z":true,"h":[11]},{"k":"v","s":53,"n":12,"t":"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰۖ","a":true,"z":true,"h":[12]},{"k":"v","s":53,"n":13,"t":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","a":true,"z":true,"h":[13]},{"k":"v","s":53,"n":14,"t":"عِندَ سِدْرَةِ اِ۬لْمُنتَهَىٰ","a":true,"z":true,"h":[14]},{"k":"v","s":53,"n":15,"t":"عِندَهَا جَنَّةُ اُ۬لْمَأْوَىٰ","a":true,"z":true,"h":[15]},{"k":"v","s":53,"n":16,"t":"إِذْ يَغْشَى اَ۬لسِّدْرَةَ مَا يَغْشَىٰۖ","a":true,"z":true,"h":[16]},{"k":"v","s":53,"n":17,"t":"مَا زَاغَ اَ۬لْبَصَرُ وَمَا طَغَىٰۖ","a":true,"z":true,"h":[17]},{"k":"v","s":53,"n":18,"t":"لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ اِ۬لْكُبْرَىٰۖ","a":true,"z":true,"h":[18]},{"k":"v","s":53,"n":19,"t":"أَفَرَٰ۬يْتُمُ اُ۬للَّٰتَ وَالْعُزَّىٰ","a":true,"z":true,"h":[19]},{"k":"v","s":53,"n":20,"t":"وَمَنَوٰةَ اَ۬لثَّالِثَةَ اَ۬لْأُخْرَىٰ","a":true,"z":true,"h":[20]},{"k":"v","s":53,"n":21,"t":"أَلَكُمُ اُ۬لذَّكَرُ وَلَهُ اُ۬لْأُنثَىٰۖ","a":true,"z":true,"h":[21]},{"k":"v","s":53,"n":22,"t":"تِلْكَ إِذاٗ قِسْمَةٞ ضِيزَىٰۖ","a":true,"z":true,"h":[22]},{"k":"v","s":53,"n":23,"t":"إِنْ هِيَ إِلَّا أَسْمَآءٞ سَمَّيْتُمُوهَا أَنتُمْ وَءَابَآؤُكُم مَّا أَنزَلَ اَ۬للَّهُ بِهَا مِن سُلْطَٰنٍۖ إِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّ وَمَا تَهْوَى اَ۬لْأَنفُسُۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ اُ۬لْهُدَىٰۖ","a":true,"z":true,"h":[23]},{"k":"v","s":53,"n":24,"t":"أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰۖ","a":true,"z":true,"h":[24]},{"k":"v","s":53,"n":25,"t":"فَلِلهِ اِ۬لْأٓخِرَةُ وَالْأُولَىٰۖ","a":true,"z":true,"h":[25]},{"k":"v","s":53,"n":26,"t":"۞ وَكَم مِّن مَّلَكٖ فِے اِ۬لسَّمَٰوَٰتِ لَا تُغْنِے شَفَٰعَتُهُمْ شَئْاً إِلَّا مِنۢ بَعْدِ أَنْ يَّأْذَنَ اَ۬للَّهُ لِمَنْ يَّشَآءُ وَيَرْضَىٰۖ","a":true,"z":true,"h":[26]}]}