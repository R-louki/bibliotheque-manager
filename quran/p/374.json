{"p":374,"j":19,"items":[{"k":"v","s":26,"n":160,"t":"كَذَّبَتْ قَوْمُ لُوطٍ اِ۬لْمُرْسَلِينَ","a":true,"z":true,"h":[160]},{"k":"v","s":26,"n":161,"t":"إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ","a":true,"z":true,"h":[161]},{"k":"v","s":26,"n":162,"t":"إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ","a":true,"z":true,"h":[162]},{"k":"v","s":26,"n":163,"t":"فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ","a":true,"z":true,"h":[163]},{"k":"v","s":26,"n":164,"t":"وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ","a":true,"z":true,"h":[164]},{"k":"v","s":26,"n":165,"t":"أَتَأْتُونَ اَ۬لذُّكْرَانَ مِنَ اَ۬لْعَٰلَمِينَ","a":true,"z":true,"h":[165]},{"k":"v","s":26,"n":166,"t":"وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُمۖ بَلْ أَنتُمْ قَوْمٌ عَادُونَۖ","a":true,"z":true,"h":[166]},{"k":"v","s":26,"n":167,"t":"قَالُواْ لَئِن لَّمْ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ اَ۬لْمُخْرَجِينَۖ","a":true,"z":true,"h":[167]},{"k":"v","s":26,"n":168,"t":"قَالَ إِنِّے لِعَمَلِكُم مِّنَ اَ۬لْقَالِينَۖ","a":true,"z":true,"h":[168]},{"k":"v","s":26,"n":169,"t":"رَبِّ نَجِّنِے وَأَهْلِے مِمَّا يَعْمَلُونَۖ","a":true,"z":true,"h":[169]},{"k":"v","s":26,"n":170,"t":"فَنَجَّيْنَٰهُ وَأَهْلَهُۥ أَجْمَعِينَ","a":true,"z":true,"h":[170]},{"k":"v","s":26,"n":171,"t":"إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ","a":true,"z":true,"h":[171]},{"k":"v","s":26,"n":172,"t":"ثُمَّ دَمَّرْنَا اَ۬لْأٓخَرِينَۖ","a":true,"z":true,"h":[172]},{"k":"v","s":26,"n":173,"t":"وَأَمْطَرْنَا عَلَيْهِم مَّطَراٗۖ فَسَآءَ مَطَرُ اُ۬لْمُنذَرِينَۖ","a":true,"z":true,"h":[173]},{"k":"v","s":26,"n":174,"t":"إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ","a":true,"z":true,"h":[174]},{"k":"v","s":26,"n":175,"t":"وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[175]},{"k":"v","s":26,"n":176,"t":"كَذَّبَ أَصْحَٰبُ لَيْكَةَ اَ۬لْمُرْسَلِينَ","a":true,"z":true,"h":[176]},{"k":"v","s":26,"n":177,"t":"إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ","a":true,"z":true,"h":[177]},{"k":"v","s":26,"n":178,"t":"إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ","a":true,"z":true,"h":[178]},{"k":"v","s":26,"n":179,"t":"فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ","a":true,"z":true,"h":[179]},{"k":"v","s":26,"n":180,"t":"وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ","a":true,"z":true,"h":[180]},{"k":"v","s":26,"n":181,"t":"۞ أَوْفُواْ اُ۬لْكَيْلَۖ وَلَا تَكُونُواْ مِنَ اَ۬لْمُخْسِرِينَۖ","a":true,"z":true,"h":[181]},{"k":"v","s":26,"n":182,"t":"وَزِنُواْ بِالْقُسْطَاسِ اِ۬لْمُسْتَقِيمِۖ","a":true,"z":true,"h":[182]},{"k":"v","s":26,"n":183,"t":"وَلَا تَبْخَسُواْ اُ۬لنَّاسَ أَشْيَآءَهُمْۖ وَلَا تَعْثَوْاْ فِے اِ۬لْأَرْضِ مُفْسِدِينَۖ","a":true,"z":true,"h":[183]}]}