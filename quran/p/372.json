{"p":372,"j":19,"items":[{"k":"v","s":26,"n":112,"t":"قَالَ وَمَا عِلْمِے بِمَا كَانُواْ يَعْمَلُونَۖ","a":true,"z":true,"h":[112]},{"k":"v","s":26,"n":113,"t":"إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّے لَوْ تَشْعُرُونَۖ","a":true,"z":true,"h":[113]},{"k":"v","s":26,"n":114,"t":"وَمَا أَنَا بِطَارِدِ اِ۬لْمُؤْمِنِينَ","a":true,"z":true,"h":[114]},{"k":"v","s":26,"n":115,"t":"إِنْ أَنَا إِلَّا نَذِيرٞ مُّبِينٞۖ","a":true,"z":true,"h":[115]},{"k":"v","s":26,"n":116,"t":"قَالُواْ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ اَ۬لْمَرْجُومِينَۖ","a":true,"z":true,"h":[116]},{"k":"v","s":26,"n":117,"t":"قَالَ رَبِّ إِنَّ قَوْمِے كَذَّبُونِ","a":true,"z":true,"h":[117]},{"k":"v","s":26,"n":118,"t":"فَافْتَحْ بَيْنِے وَبَيْنَهُمْ فَتْحاٗ وَنَجِّنِے وَمَن مَّعِے مِنَ اَ۬لْمُؤْمِنِينَۖ","a":true,"z":true,"h":[118]},{"k":"v","s":26,"n":119,"t":"فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِۖ","a":true,"z":true,"h":[119]},{"k":"v","s":26,"n":120,"t":"ثُمَّ أَغْرَقْنَا بَعْدُ اُ۬لْبَاقِينَۖ","a":true,"z":true,"h":[120]},{"k":"v","s":26,"n":121,"t":"إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ","a":true,"z":true,"h":[121]},{"k":"v","s":26,"n":122,"t":"وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[122]},{"k":"v","s":26,"n":123,"t":"كَذَّبَتْ عَادٌ اِ۬لْمُرْسَلِينَ","a":true,"z":true,"h":[123]},{"k":"v","s":26,"n":124,"t":"إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ","a":true,"z":true,"h":[124]},{"k":"v","s":26,"n":125,"t":"إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ","a":true,"z":true,"h":[125]},{"k":"v","s":26,"n":126,"t":"فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ","a":true,"z":true,"h":[126]},{"k":"v","s":26,"n":127,"t":"وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ","a":true,"z":true,"h":[127]},{"k":"v","s":26,"n":128,"t":"أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةٗ تَعْبَثُونَ","a":true,"z":true,"h":[128]},{"k":"v","s":26,"n":129,"t":"وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ","a":true,"z":true,"h":[129]},{"k":"v","s":26,"n":130,"t":"وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَۖ","a":true,"z":true,"h":[130]},{"k":"v","s":26,"n":131,"t":"فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ","a":true,"z":true,"h":[131]},{"k":"v","s":26,"n":132,"t":"وَاتَّقُواْ اُ۬لذِے أَمَدَّكُم بِمَا تَعْلَمُونَ","a":true,"z":true,"h":[132]},{"k":"v","s":26,"n":133,"t":"أَمَدَّكُم بِأَنْعَٰمٖ وَبَنِينَ","a":true,"z":true,"h":[133]},{"k":"v","s":26,"n":134,"t":"وَجَنَّٰتٖ وَعُيُونٍۖ","a":true,"z":true,"h":[134]},{"k":"v","s":26,"n":135,"t":"إِنِّيَ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٖۖ","a":true,"z":true,"h":[135]},{"k":"v","s":26,"n":136,"t":"قَالُواْ سَوَآءٌ عَلَيْنَا أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ اَ۬لْوَٰعِظِينَ","a":true,"z":true,"h":[136]}]}