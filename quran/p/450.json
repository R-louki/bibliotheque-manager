{"p":450,"j":23,"items":[{"k":"v","s":37,"n":103,"t":"فَلَمَّا أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ","a":true,"z":true,"h":[103]},{"k":"v","s":37,"n":104,"t":"وَنَٰدَيْنَٰهُ أَنْ يَّٰإِبْرَٰهِيمُ","a":true,"z":true,"h":[104]},{"k":"v","s":37,"n":105,"t":"قَدْ صَدَّقْتَ اَ۬لرُّءْيَاۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ","a":true,"z":true,"h":[105]},{"k":"v","s":37,"n":106,"t":"إِنَّ هَٰذَا لَهْوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ","a":true,"z":true,"h":[106]},{"k":"v","s":37,"n":107,"t":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ","a":true,"z":true,"h":[107]},{"k":"v","s":37,"n":108,"t":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لْأٓخِرِينَۖ","a":true,"z":true,"h":[108]},{"k":"v","s":37,"n":109,"t":"سَلَٰمٌ عَلَىٰ إِبْرَٰهِيمَۖ","a":true,"z":true,"h":[109]},{"k":"v","s":37,"n":110,"t":"كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ","a":true,"z":true,"h":[110]},{"k":"v","s":37,"n":111,"t":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ","a":true,"z":true,"h":[111]},{"k":"v","s":37,"n":112,"t":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ","a":true,"z":true,"h":[112]},{"k":"v","s":37,"n":113,"t":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ","a":true,"z":true,"h":[113]},{"k":"v","s":37,"n":114,"t":"۞ وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","a":true,"z":true,"h":[114]},{"k":"v","s":37,"n":115,"t":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ","a":true,"z":true,"h":[115]},{"k":"v","s":37,"n":116,"t":"وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ","a":true,"z":true,"h":[116]},{"k":"v","s":37,"n":117,"t":"وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ","a":true,"z":true,"h":[117]},{"k":"v","s":37,"n":118,"t":"وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ","a":true,"z":true,"h":[118]},{"k":"v","s":37,"n":119,"t":"وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لْأٓخِرِينَۖ","a":true,"z":true,"h":[119]},{"k":"v","s":37,"n":120,"t":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَۖ","a":true,"z":true,"h":[120]},{"k":"v","s":37,"n":121,"t":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ","a":true,"z":true,"h":[121]},{"k":"v","s":37,"n":122,"t":"إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُؤْمِنِينَۖ","a":true,"z":true,"h":[122]},{"k":"v","s":37,"n":123,"t":"وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ","a":true,"z":true,"h":[123]},{"k":"v","s":37,"n":124,"t":"إِذْ قَالَ لِقَوْمِهِۦ أَلَا تَتَّقُونَ","a":true,"z":true,"h":[124]},{"k":"v","s":37,"n":125,"t":"أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ","a":true,"z":true,"h":[125]},{"k":"v","s":37,"n":126,"t":"اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لْأَوَّلِينَۖ","a":true,"z":true,"h":[126]}]}