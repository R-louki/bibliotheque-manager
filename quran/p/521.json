{"p":521,"j":26,"items":[{"k":"v","s":51,"n":7,"t":"وَالسَّمَآءِ ذَاتِ اِ۬لْحُبُكِ","a":true,"z":true,"h":[7]},{"k":"v","s":51,"n":8,"t":"إِنَّكُمْ لَفِے قَوْلٖ مُّخْتَلِفٖ","a":true,"z":true,"h":[8]},{"k":"v","s":51,"n":9,"t":"يُؤْفَكُ عَنْهُ مَنْ أُفِكَۖ","a":true,"z":true,"h":[9]},{"k":"v","s":51,"n":10,"t":"قُتِلَ اَ۬لْخَرَّٰصُونَ","a":true,"z":true,"h":[10]},{"k":"v","s":51,"n":11,"t":"اَ۬لذِينَ هُمْ فِے غَمْرَةٖ سَاهُونَۖ","a":true,"z":true,"h":[11]},{"k":"v","s":51,"n":12,"t":"يَسْـَٔلُونَ أَيَّانَ يَوْمُ اُ۬لدِّينِ","a":true,"z":true,"h":[12]},{"k":"v","s":51,"n":13,"t":"يَوْمَ هُمْ عَلَى اَ۬لنَّارِ يُفْتَنُونَۖ","a":true,"z":true,"h":[13]},{"k":"v","s":51,"n":14,"t":"ذُوقُواْ فِتْنَتَكُمْۖ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تَسْتَعْجِلُونَۖ","a":true,"z":true,"h":[14]},{"k":"v","s":51,"n":15,"t":"إِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتٖ وَعُيُونٍ","a":true,"z":true,"h":[15]},{"k":"v","s":51,"n":16,"t":"ءَاخِذِينَ مَا ءَاتَيٰهُمْ رَبُّهُمْۖ إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُحْسِنِينَۖ","a":true,"z":true,"h":[16]},{"k":"v","s":51,"n":17,"t":"كَانُواْ قَلِيلاٗۖ مِّنَ اَ۬ليْلِ مَا يَهْجَعُونَۖ","a":true,"z":true,"h":[17]},{"k":"v","s":51,"n":18,"t":"وَبِالْأَسْحَارِ هُمْ يَسْتَغْفِرُونَۖ","a":true,"z":true,"h":[18]},{"k":"v","s":51,"n":19,"t":"وَفِے أَمْوَٰلِهِمْ حَقّٞ لِّلسَّآئِلِ وَالْمَحْرُومِۖ","a":true,"z":true,"h":[19]},{"k":"v","s":51,"n":20,"t":"وَفِے اِ۬لْأَرْضِ ءَايَٰتٞ لِّلْمُوقِنِينَۖ","a":true,"z":true,"h":[20]},{"k":"v","s":51,"n":21,"t":"وَفِے أَنفُسِكُمْۖ أَفَلَا تُبْصِرُونَۖ","a":true,"z":true,"h":[21]},{"k":"v","s":51,"n":22,"t":"وَفِے اِ۬لسَّمَآءِ رِزْقُكُمْۖ وَمَا تُوعَدُونَ","a":true,"z":true,"h":[22]},{"k":"v","s":51,"n":23,"t":"فَوَرَبِّ اِ۬لسَّمَآءِ وَالْأَرْضِ إِنَّهُۥ لَحَقّٞ مِّثْلَ مَا أَنَّكُمْ تَنطِقُونَۖ","a":true,"z":true,"h":[23]},{"k":"v","s":51,"n":24,"t":"هَلْ أَتَيٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ اَ۬لْمُكْرَمِينَ","a":true,"z":true,"h":[24]},{"k":"v","s":51,"n":25,"t":"إِذْ دَخَلُواْ عَلَيْهِ فَقَالُواْ سَلَٰماٗۖ قَالَ سَلَٰمٞۖ قَوْ