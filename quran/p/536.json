{"p":536,"j":27,"items":[{"k":"v","s":56,"n":54,"t":"ثُمَّ إِنَّكُمْ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ","a":true,"z":true,"h":[51]},{"k":"v","s":56,"n":55,"t":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","a":true,"z":true,"h":[52]},{"k":"v","s":56,"n":56,"t":"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ","a":true,"z":true,"h":[53]},{"k":"v","s":56,"n":57,"t":"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ","a":true,"z":true,"h":[54]},{"k":"v","s":56,"n":58,"t":"فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ","a":true,"z":true,"h":[55]},{"k":"v","s":56,"n":59,"t":"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ","a":true,"z":true,"h":[56]},{"k":"v","s":56,"n":60,"t":"نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ","a":true,"z":true,"h":[57]},{"k":"v","s":56,"n":61,"t":"أَفَرَٰ۬يْتُم مَّا تُمْنُونَ","a":true,"z":true,"h":[58]},{"k":"v","s":56,"n":62,"t":"ءَٰا۬نتُمْ تَخْلُقُونَهُۥ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ","a":true,"z":true,"h":[59]},{"k":"v","s":56,"n":63,"t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","a":true,"z":true,"h":[60]},{"k":"v","s":56,"n":64,"t":"عَلَىٰ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ","a":true,"z":true,"h":[61]},{"k":"v","s":56,"n":65,"t":"وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لْأُولَىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ","a":true,"z":true,"h":[62]},{"k":"v","s":56,"n":66,"t":"أَفَرَٰ۬يْتُم مَّا تَحْرُثُونَ","a":true,"z":true,"h":[63]},{"k":"v","s":56,"n":67,"t":"ءَٰا۬نتُمْ تَزْرَعُونَهُۥ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ","a":true,"z":true,"h":[64]},{"k":"v","s":56,"n":68,"t":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ","a":true,"z":true,"h":[65]},{"k":"v","s":56,"n":69,"t":"إِنَّا لَمُغْرَمُونَ","a":true,"z":true,"h":[66]},{"k":"v","s":56,"n":70,"t":"بَلْ نَحْنُ مَحْرُومُونَۖ","a":true,"z":true,"h":[67]},{"k":"v","s":56,"n":71,"t":"أَفَرَٰ۬يْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ","a":true,"z":true,"h":[68]},{"k":"v","s":56,"n":72,"t":"ءَٰا۬نتُمْ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ","a":true,"z":true,"