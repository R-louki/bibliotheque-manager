{"p":373,"j":19,"items":[{"k":"v","s":26,"n":137,"t":"إِنْ هَٰذَا إِلَّا خُلُقُ اُ۬لْأَوَّلِينَ","a":true,"z":true,"h":[137]},{"k":"v","s":26,"n":138,"t":"وَمَا نَحْنُ بِمُعَذَّبِينَۖ","a":true,"z":true,"h":[138]},{"k":"v","s":26,"n":139,"t":"فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ","a":true,"z":true,"h":[139]},{"k":"v","s":26,"n":140,"t":"وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[140]},{"k":"v","s":26,"n":141,"t":"كَذَّبَتْ ثَمُودُ اُ۬لْمُرْسَلِينَ","a":true,"z":true,"h":[141]},{"k":"v","s":26,"n":142,"t":"إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ","a":true,"z":true,"h":[142]},{"k":"v","s":26,"n":143,"t":"إِنِّے لَكُمْ رَسُولٌ أَمِينٞۖ","a":true,"z":true,"h":[143]},{"k":"v","s":26,"n":144,"t":"فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ","a":true,"z":true,"h":[144]},{"k":"v","s":26,"n":145,"t":"وَمَا أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍۖ إِنْ أَجْرِيَ إِلَّا عَلَىٰ رَبِّ اِ۬لْعَٰلَمِينَۖ","a":true,"z":true,"h":[145]},{"k":"v","s":26,"n":146,"t":"۞ أَتُتْرَكُونَ فِے مَا هَٰهُنَا ءَامِنِينَ","a":true,"z":true,"h":[146]},{"k":"v","s":26,"n":147,"t":"فِے جَنَّٰتٖ وَعُيُونٖ","a":true,"z":true,"h":[147]},{"k":"v","s":26,"n":148,"t":"وَزُرُوعٖ وَنَخْلٖ طَلْعُهَا هَضِيمٞ","a":true,"z":true,"h":[148]},{"k":"v","s":26,"n":149,"t":"وَتَنْحِتُونَ مِنَ اَ۬لْجِبَالِ بِيُوتاٗ فَرِهِينَۖ","a":true,"z":true,"h":[149]},{"k":"v","s":26,"n":150,"t":"فَاتَّقُواْ اُ۬للَّهَ وَأَطِيعُونِۖ","a":true,"z":true,"h":[150]},{"k":"v","s":26,"n":151,"t":"وَلَا تُطِيعُواْ أَمْرَ اَ۬لْمُسْرِفِينَ","a":true,"z":true,"h":[151]},{"k":"v","s":26,"n":152,"t":"اَ۬لذِينَ يُفْسِدُونَ فِے اِ۬لْأَرْضِ وَلَا يُصْلِحُونَۖ","a":true,"z":true,"h":[152]},{"k":"v","s":26,"n":153,"t":"قَالُواْ إِنَّمَا أَنتَ مِنَ اَ۬لْمُسَحَّرِينَ","a":true,"z":true,"h":[153]},{"k":"v","s":26,"n":154,"t":"مَا أَنتَ إِلَّا بَشَرٞ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ","a":true,"z":true,"h":[154]},{"k":"v","s":26,"n":155,"t":"قَالَ هَٰذِهِۦ نَاقَةٞ لَّهَا شِرْبٞۖ وَلَكُمْ شِرْبُ يَوْمٖ مَّعْلُومٖۖ","a":true,"z":true,"h":[155]},{"k":"v","s":26,"n":156,"t":"وَلَا تَمَسُّوهَا بِسُوٓءٖ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٖۖ","a":true,"z":true,"h":[156]},{"k":"v","s":26,"n":157,"t":"فَعَقَرُوهَا فَأَصْبَحُواْ نَٰدِمِينَ","a":true,"z":true,"h":[157]},{"k":"v","s":26,"n":158,"t":"فَأَخَذَهُمُ اُ۬لْعَذَابُۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ","a":true,"z":true,"h":[158]},{"k":"v","s":26,"n":159,"t":"وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[159]}]}