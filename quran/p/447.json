{"p":447,"j":23,"items":[{"k":"v","s":37,"n":25,"t":"مَا لَكُمْ لَا تَنَاصَرُونَۖ","a":true,"z":true,"h":[25]},{"k":"v","s":37,"n":26,"t":"بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ","a":true,"z":true,"h":[26]},{"k":"v","s":37,"n":27,"t":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ","a":true,"z":true,"h":[27]},{"k":"v","s":37,"n":28,"t":"قَالُواْ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ اِ۬لْيَمِينِۖ","a":true,"z":true,"h":[28]},{"k":"v","s":37,"n":29,"t":"قَالُواْ بَل لَّمْ تَكُونُواْ مُؤْمِنِينَۖ","a":true,"z":true,"h":[29]},{"k":"v","s":37,"n":30,"t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ","a":true,"z":true,"h":[30]},{"k":"v","s":37,"n":31,"t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا إِنَّا لَذَآئِقُونَ","a":true,"z":true,"h":[31]},{"k":"v","s":37,"n":32,"t":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَۖ","a":true,"z":true,"h":[32]},{"k":"v","s":37,"n":33,"t":"فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ","a":true,"z":true,"h":[33]},{"k":"v","s":37,"n":34,"t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ","a":true,"z":true,"h":[34]},{"k":"v","s":37,"n":35,"t":"إِنَّهُمْ كَانُواْ إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ","a":true,"z":true,"h":[35]},{"k":"v","s":37,"n":36,"t":"وَيَقُولُونَ أَٰئِنَّا لَتَارِكُواْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ","a":true,"z":true,"h":[36]},{"k":"v","s":37,"n":37,"t":"بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ","a":true,"z":true,"h":[37]},{"k":"v","s":37,"n":38,"t":"إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لْأَلِيمِۖ","a":true,"z":true,"h":[38]},{"k":"v","s":37,"n":39,"t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","a":true,"z":true,"h":[39]},{"k":"v","s":37,"n":40,"t":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ","a":true,"z":true,"h":[40]},{"k":"v","s":37,"n":41,"t":"أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ","a":true,"z":true,"h":[41]},{"k":"v","s":37,"n":42,"t":"فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ","a":true,"z":true,"h":[42]},{"k":"v","s":37,"n":43,"t":"فِے جَنَّٰتِ اِ۬لنَّعِيمِ","a":true,"z":true,"h":[43]},{"k":"v","s":37,"n":44,"t":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَۖ","a":true,"z":true,"h":[44]},{"k":"v","s":37,"n":45,"t":"يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ","a":true,"z":true,"h":[45]},{"k":"v","s":37,"n":46,"t":"بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ","a":true,"z":true,"h":[46]},{"k":"v","s":37,"n":47,"t":"لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ","a":true,"z":true,"h":[47]},{"k":"v","s":37,"n":48,"t":"وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ","a":true,"z":true,"h":[48]},{"k":"v","s":37,"n":49,"t":"كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ","a":true,"z":true,"h":[49]},{"k":"v","s":37,"n":50,"t":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ","a":true,"z":true,"h":[50]},{"k":"v","s":37,"n":51,"t":"۞ قَالَ قَآئِلٞ مِّنْهُمْ إِنِّے كَانَ لِے قَرِينٞ","a":true,"z":true,"h":[51]}]}