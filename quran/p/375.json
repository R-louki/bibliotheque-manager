{"p":375,"j":19,"items":[{"k":"v","s":26,"n":184,"t":"وَاتَّقُواْ اُ۬لذِے خَلَقَكُمْ وَالْجِبِلَّةَ اَ۬لْأَوَّلِينَۖ","a":true,"z":true,"h":[184]},{"k":"v","s":26,"n":185,"t":"قَالُواْ إِنَّمَا أَنتَ مِنَ اَ۬لْمُسَحَّرِينَ","a":true,"z":true,"h":[185]},{"k":"v","s":26,"n":186,"t":"وَمَا أَنتَ إِلَّا بَشَرٞ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ اَ۬لْكَٰذِبِينَ","a":true,"z":true,"h":[186]},{"k":"v","s":26,"n":187,"t":"فَأَسْقِطْ عَلَيْنَا كِسْفاٗ مِّنَ اَ۬لسَّمَآ۟ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ","a":true,"z":true,"h":[187]},{"k":"v","s":26,"n":188,"t":"قَالَ رَبِّيَ أَعْلَمُ بِمَا تَعْمَلُونَۖ","a":true,"z":true,"h":[188]},{"k":"v","s":26,"n":189,"t":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ اِ۬لظُّلَّةِۖ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍۖ","a":true,"z":true,"h":[189]},{"k":"v","s":26,"n":190,"t":"إِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَۖ","a":true,"z":true,"h":[190]},{"k":"v","s":26,"n":191,"t":"وَإِنَّ رَبَّكَ لَهْوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ","a":true,"z":true,"h":[191]},{"k":"v","s":26,"n":192,"t":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ اِ۬لْعَٰلَمِينَۖ","a":true,"z":true,"h":[192]},{"k":"v","s":26,"n":193,"t":"نَزَلَ بِهِ اِ۬لرُّوحُ اُ۬لْأَمِينُ","a":true,"z":true,"h":[193]},{"k":"v","s":26,"n":194,"t":"عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ اَ۬لْمُنذِرِينَ","a":true,"z":true,"h":[194]},{"k":"v","s":26,"n":195,"t":"بِلِسَانٍ عَرَبِيّٖ مُّبِينٖۖ","a":true,"z":true,"h":[195]},{"k":"v","s":26,"n":196,"t":"وَإِنَّهُۥ لَفِے زُبُرِ اِ۬لْأَوَّلِينَۖ","a":true,"z":true,"h":[196]},{"k":"v","s":26,"n":197,"t":"أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَنْ يَّعْلَمَهُۥ عُلَمَٰٓؤُاْ بَنِے إِسْرَآءِيلَۖ","a":true,"z":true,"h":[197]},{"k":"v","s":26,"n":198,"t":"وَلَوْ نَزَّلْنَٰهُ عَلَىٰ بَعْضِ اِ۬لْأَعْجَمِينَ","a":true,"z":true,"h":[198]},{"k":"v","s":26,"n":199,"t":"فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُواْ بِهِۦ مُؤْمِنِينَۖ","a":true,"z":true,"h":[199]},{"k":"v","s":26,"n":200,"t":"كَذَٰلِكَ سَلَكْنَٰهُ فِے قُلُوبِ اِ۬لْمُجْرِمِينَ","a":true,"z":true,"h":[200]},{"k":"v","s":26,"n":201,"t":"لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ اُ۬لْعَذَابَ اَ۬لْأَلِيمَ","a":true,"z":true,"h":[201]},{"k":"v","s":26,"n":202,"t":"فَيَأْتِيَهُم بَغْتَةٗ وَهُمْ لَا يَشْعُرُونَ","a":true,"z":true,"h":[202]},{"k":"v","s":26,"n":203,"t":"فَيَقُولُواْ هَلْ نَحْنُ مُنظَرُونَۖ","a":true,"z":true,"h":[203]},{"k":"v","s":26,"n":204,"t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ","a":true,"z":true,"h":[204]},{"k":"v","s":26,"n":205,"t":"أَفَرَٰ۬يْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ","a":true,"z":true,"h":[205]},{"k":"v","s":26,"n":206,"t":"ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ","a":true,"z":true,"h":[206]}]}